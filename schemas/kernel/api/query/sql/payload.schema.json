{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/query/sql/payload.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "payload body",
            "description": "query the database using SQL",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "stmt"
            ],
            "properties": {
                "mode": {
                    "type": "string",
                    "title": "TSQLMode",
                    "description": "Statement check mode\n- Empty string: A single statement\n- `readonly`: A single read-only statement\n- `multiple`: Multiple statements, the result of the last one is returned",
                    "default": "",
                    "enum": [
                        "",
                        "multiple",
                        "readonly"
                    ]
                },
                "stmt": {
                    "type": "string",
                    "description": "SQL query statements"
                }
            }
        }
    }
}