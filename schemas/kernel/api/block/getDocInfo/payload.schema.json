{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/block/getDocInfo/payload.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "payload body",
            "description": "Get document information",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "ids": {
                    "type": "array",
                    "description": "Additional block IDs, only used to check whether the encrypted notebooks containing them are unlocked",
                    "items": {
                        "type": "string",
                        "pattern": "^\\d{14}-[0-9a-z]{7}$"
                    }
                },
                "notebook": {
                    "type": "string",
                    "description": "ID of the encrypted notebook containing the block, required for blocks in encrypted notebooks",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                }
            }
        }
    }
}