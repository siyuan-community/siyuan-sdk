/**
 * schemas/kernel/api/filetree/getDoc/payload.schema.json5
 * 获取块 DOM 与相关信息
 * REF: https://github.com/siyuan-note/siyuan/blob/v3.8.6/kernel/api/filetree.go#L1219-L1323
 * @pathname: /api/filetree/getDoc
 * @version: 3.8.6
 */
{
    $schema: 'https://json-schema.org/draft/2020-12/schema',
    $id: 'https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/filetree/getDoc/payload.schema.json5',
    $comment: 'v3.8.6',
    $ref: '#/$defs/root',
    $defs: {
        root: {
            title: 'payload body',
            description: 'Get block HTML DOM and other information',

            type: 'object',
            additionalProperties: false,
            required: [
                'id',
            ],
            dependentRequired: {
                /**
                 * 属性相互依赖
                 * REF: https://ajv.js.org/json-schema.html#dependentrequired
                 */
                startID: [
                    'endID',
                    'scroll',
                ],
                endID: [
                    'startID',
                    'scroll',
                ],
            },
            properties: {
                id: {
                    // 块 ID
                    type: 'string',
                    description: 'Block ID',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                },
                index: {
                    // 块索引序号
                    type: 'integer',
                    description: 'Block index',
                    minimum: 0,
                    default: 0,
                },
                query: {
                    // 查询语句
                    type: 'string',
                    description: 'Query statements',
                    default: '',
                },
                queryMethod: {
                    // 查询方案
                    type: 'integer',
                    description: 'Query method',
                    enum: [
                        0, // 关键字
                        1, // 查询语法
                        2, // SQL
                        3, // 正则表达式
                    ],
                    default: 0,
                },
                queryTypes: {
                    // 块类型过滤
                    $ref: '#/$defs/queryTypes',
                },
                mode: {
                    // 加载模式
                    type: 'integer',
                    description: 'Load mode',
                    enum: [
                        0, // 仅加载 ID 指定的块
                        1, // 加载上方内容
                        2, // 加载下方内容
                        3, // 加载上下方内容
                        4, // 加载末尾内容
                    ],
                    default: 0,
                },
                size: {
                    // 最大加载块数
                    type: 'integer',
                    description: 'Maximum number of loaded blocks',
                    default: 102400,
                    minimum: 1,
                },
                startID: {
                    // 起始块 ID
                    type: 'string',
                    description: 'The starting block ID',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                    default: '',
                },
                endID: {
                    // 终止块 ID
                    type: 'string',
                    description: 'The end block ID',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                    default: '',
                },
                isBacklink: {
                    // 是否为反向链接
                    type: 'boolean',
                    description: 'Whether it is a reverse link',
                    default: false,
                },
                reqId: {
                    // 请求 ID
                    type: 'integer',
                    description: 'Request ID (Unix timestamp)',
                },
                highlight: {
                    // 是否高亮 query 的命中内容
                    type: 'boolean',
                    description: 'Whether to highlight the matches of `query`',
                    default: true,
                },
                includeDocInfo: {
                    // 是否在响应中返回文档信息 docInfo
                    type: 'boolean',
                    description: 'Whether to include the document information `docInfo` in the response',
                    default: false,
                },
                notebook: {
                    // 文档所在的加密笔记本 ID，读取加密笔记本中的文档时需要
                    type: 'string',
                    description: 'ID of the encrypted notebook containing the document, required for documents in encrypted notebooks',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                },
                originalRefBlockIDs: {
                    // 反链上下文块 ID 到原引用块 ID 的映射，仅在 isBacklink 为 true 时使用
                    type: 'object',
                    description: 'Map from backlink context block IDs to the original referencing block IDs, only used when `isBacklink` is `true`',
                    additionalProperties: {
                        type: 'string',
                    },
                },
                querySubTypes: {
                    // 查询时的块子类型过滤器
                    $ref: '#/$defs/querySubTypes',
                },
            },
        },
        queryTypes: {
            title: 'IQueryTypes',
            description: 'Query the specified block type (block type filter)',

            type: 'object',
            additionalProperties: false,
            required: [],
            properties: {
                document: {
                    // 文档块
                    description: 'Document block',
                    type: 'boolean',
                    default: false,
                },
                heading: {
                    // 标题块
                    description: 'Heading block',
                    type: 'boolean',
                    default: false,
                },
                list: {
                    // 列表块
                    description: 'List block',
                    type: 'boolean',
                    default: false,
                },
                listItem: {
                    // 列表项
                    description: 'List item block',
                    type: 'boolean',
                    default: false,
                },
                codeBlock: {
                    // 代码块
                    description: 'Code block',
                    type: 'boolean',
                    default: false,
                },
                mathBlock: {
                    // 公式块
                    description: 'Math formula block',
                    type: 'boolean',
                    default: false,
                },
                table: {
                    // 表格块
                    description: 'Table block',
                    type: 'boolean',
                    default: false,
                },
                blockquote: {
                    // 引述块
                    description: 'Quote block',
                    type: 'boolean',
                    default: false,
                },
                superBlock: {
                    // 超级块
                    description: 'Super blok',
                    type: 'boolean',
                    default: false,
                },
                paragraph: {
                    // 段落块
                    description: 'Paragraph block',
                    type: 'boolean',
                    default: false,
                },
                htmlBlock: {
                    // HTML 块
                    description: 'HTML block',
                    type: 'boolean',
                    default: false,
                },
                embedBlock: {
                    // 嵌入块
                    description: 'Embed block',
                    type: 'boolean',
                    default: false,
                },
                audioBlock: {
                    // 音频块
                    description: 'Audio block',
                    type: 'boolean',
                    default: false,
                },
                callout: {
                    // 提示块
                    description: 'Callout',
                    type: 'boolean',
                    default: false,
                },
                customBlock: {
                    // 自定义块
                    description: 'Custom block',
                    type: 'boolean',
                    default: false,
                },
                databaseBlock: {
                    // 数据库块
                    description: 'Database block',
                    type: 'boolean',
                    default: false,
                },
                iframeBlock: {
                    // IFrame 块
                    description: 'IFrame block',
                    type: 'boolean',
                    default: false,
                },
                mindmap: {
                    // 思维导图块
                    description: 'Mind map block',
                    type: 'boolean',
                    default: false,
                },
                mindmapItem: {
                    // 思维导图项块
                    description: 'Mind map item block',
                    type: 'boolean',
                    default: false,
                },
                tabItem: {
                    // 页签项块
                    description: 'Tab item block',
                    type: 'boolean',
                    default: false,
                },
                tabs: {
                    // 页签块
                    description: 'Tabbed block',
                    type: 'boolean',
                    default: false,
                },
                videoBlock: {
                    // 视频块
                    description: 'Video block',
                    type: 'boolean',
                    default: false,
                },
                widgetBlock: {
                    // 挂件块
                    description: 'Widget block',
                    type: 'boolean',
                    default: false,
                },
            },
        },
        querySubTypes: {
            title: 'IQuerySubTypes',
            description: 'Block subtype filter, all subtypes of a type match when none of its subtypes is `true`',

            type: 'object',
            additionalProperties: false,
            properties: {
                heading: {
                    // 标题块的子类型
                    $ref: '#/$defs/querySubTypes_heading',
                },
                list: {
                    // 列表块的子类型
                    $ref: '#/$defs/querySubTypes_list',
                },
                listItem: {
                    // 列表项块的子类型
                    $ref: '#/$defs/querySubTypes_list',
                },
            },
        },
        querySubTypes_heading: {
            title: 'IQuerySubTypesHeading',
            description: 'Heading levels',

            type: 'object',
            additionalProperties: false,
            properties: {
                h1: {
                    type: 'boolean',
                    description: 'Heading 1',
                },
                h2: {
                    type: 'boolean',
                    description: 'Heading 2',
                },
                h3: {
                    type: 'boolean',
                    description: 'Heading 3',
                },
                h4: {
                    type: 'boolean',
                    description: 'Heading 4',
                },
                h5: {
                    type: 'boolean',
                    description: 'Heading 5',
                },
                h6: {
                    type: 'boolean',
                    description: 'Heading 6',
                },
            },
        },
        querySubTypes_list: {
            title: 'IQuerySubTypesList',
            description: 'List types',

            type: 'object',
            additionalProperties: false,
            properties: {
                o: {
                    // 有序列表
                    type: 'boolean',
                    description: 'Ordered list',
                },
                t: {
                    // 任务列表
                    type: 'boolean',
                    description: 'Task list',
                },
                u: {
                    // 无序列表
                    type: 'boolean',
                    description: 'Unordered list',
                },
            },
        },
    },
}
