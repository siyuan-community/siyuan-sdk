{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/block/updateBlock/payload.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "payload body",
            "description": "Update a block",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "dataType",
                "data",
                "id"
            ],
            "properties": {
                "dataType": {
                    "title": "TDataType",
                    "type": "string",
                    "description": "block data format",
                    "enum": [
                        "markdown",
                        "dom"
                    ]
                },
                "data": {
                    "type": "string",
                    "description": "Data to be updated"
                },
                "id": {
                    "type": "string",
                    "description": "ID of the block to be updated",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "lockType": {
                    "type": "boolean",
                    "description": "Whether to forbid changing the block type, the update fails when the new content has a different block type",
                    "default": false
                }
            }
        }
    }
}