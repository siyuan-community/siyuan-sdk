/**
 * schemas/kernel/api/system/getConf/response.schema.json5
 * 获取工作空间完整配置
 * REF: https://github.com/siyuan-note/siyuan/blob/v3.8.6/kernel/api/system.go#L746-L792
 * @pathname: /api/system/getConf
 * @version: 3.8.6
 */
{
    $schema: 'https://json-schema.org/draft/2020-12/schema',
    $id: 'https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/system/getConf/response.schema.json5',
    $comment: 'v3.8.6',
    $ref: '#/$defs/root',
    $defs: {
        root: {
            title: 'response body',
            description: 'Get the full configuration of the workspace',

            type: 'object',
            additionalProperties: false,
            required: [
                'code',
                'msg',
                'data',
            ],
            properties: {
                code: {
                    type: 'integer',
                    description: 'status code',
                },
                msg: {
                    type: 'string',
                    description: 'status message',
                },
                data: {
                    $ref: '#/$defs/data',
                },
            },
        },
        data: {
            title: 'IData',
            description: 'response data',

            type: 'object',
            additionalProperties: false,
            required: [
                'conf',
                'isPublish',
                'start',
            ],
            properties: {
                start: {
                    // 是否未加载用户界面
                    type: 'boolean',
                    description: 'Whether the user interface is not loaded',
                },
                isPublish: {
                    // 是否为发布模式
                    type: 'boolean',
                    description: 'Whether it is in publish mode',
                },
                conf: {
                    // 配置对象
                    $ref: '#/$defs/conf',
                },
            },
        },
        conf: {
            title: 'IConf',
            description: 'Configuration object',

            type: 'object',
            additionalProperties: false,
            required: [
                'accessAuthCode',
                'ai',
                'api',
                'appearance',
                'bazaar',
                'cloudRegion',
                'cookieKey',
                'dataIndexState',
                'editor',
                'export',
                'fileTree',
                'flashcard',
                'graph',
                'keymap',
                'lang',
                'langs',
                'logLevel',
                'mcpOAuth',
                'notebookCrypto',
                'oidc',
                'onboarding',
                'publish',
                'readonly',
                'repo',
                'search',
                'secrets',
                'serverAddrs',
                'showChangelog',
                'snippet',
                'stat',
                'sync',
                'system',
                'tag',
                'uiLayout',
                'userData',
                'variables',
            ],
            properties: {
                accessAuthCode: {
                    // 访问授权码
                    type: 'string',
                    title: 'TAccessAuthCode',
                    description: 'Access authorization code',
                    default: '',
                    enum: [
                        '',
                        '*******',
                    ],
                },
                ai: {
                    // AI 相关设置项
                    $ref: '#/$defs/ai',
                },
                api: {
                    // 思源 API 相关设置项
                    $ref: '#/$defs/api',
                },
                appearance: {
                    // 外观相关设置项
                    $ref: '#/$defs/appearance',
                },
                bazaar: {
                    // 思源集市相关设置项
                    $ref: '#/$defs/bazaar',
                },
                cloudRegion: {
                    // 云服务供应商地区
                    type: 'integer',
                    description: 'Cloud Service Provider Region\n- `0`: Chinese mainland\n- `1`: North America',
                    enum: [
                        0,
                        1,
                    ],
                },
                cookieKey: {
                    // 会话 Cookie 加密密钥（该 API 始终返回空字符串）
                    type: 'string',
                    description: 'Key used to encrypt session cookies (always an empty string in this API)',
                },
                dataIndexState: {
                    // 数据索引状态
                    type: 'integer',
                    description: 'Data index status\n- `0`: Indexed\n- `1`: Not indexed',
                    enum: [
                        0, // 已索引
                        1, // 未索引
                    ],
                },
                editor: {
                    // 编辑器相关设置项
                    $ref: '#/$defs/editor',
                },
                export: {
                    // 导出相关设置项
                    $ref: '#/$defs/export',
                },
                fileTree: {
                    // 文档树相关设置项
                    $ref: '#/$defs/fileTree',
                },
                flashcard: {
                    // 闪卡相关设置项
                    $ref: '#/$defs/flashcard',
                },
                graph: {
                    // 图谱相关设置项
                    $ref: '#/$defs/graph',
                },
                keymap: {
                    // 快捷键设置项
                    $ref: '#/$defs/keymap',
                },
                langs: {
                    // 支持的语言列表
                    type: 'array',
                    description: 'List of supported languages',
                    items: {
                        $ref: '#/$defs/lang',
                    },
                },
                lang: {
                    // 界面语言
                    type: 'string',
                    title: 'TLang',
                    description: 'User interface language  \nSame as {@link IAppearance.lang}',
                    enum: [
                        'ar', // 阿拉伯文
                        'de', // 德文
                        'en', // 英文
                        'es', // 西班牙文
                        'fr', // 法文
                        'he', // 希伯来文
                        'hi', // 印地文
                        'id', // 印度尼西亚文
                        'it', // 意大利文
                        'ja', // 日文
                        'ko', // 韩文
                        'nl', // 荷兰文
                        'pl', // 波兰文
                        'pt-BR', // 巴西葡萄牙文
                        'ru', // 俄文
                        'sk', // 斯洛伐克文
                        'sr', // 塞尔维亚文
                        'th', // 泰文
                        'tr', // 土耳其文
                        'uk', // 乌克兰文
                        'zh-CN', // 简体中文
                        'zh-TW', // 繁体中文
                    ],
                },
                logLevel: {
                    // 日志级别
                    type: 'string',
                    title: 'TLogLevel',
                    description: 'Log level',
                    enum: [
                        'off', // 无日志
                        'trace', // 少量
                        'debug', // 调试
                        'info', // 信息
                        'warn', // 警告
                        'error', // 错误
                        'fatal', // 致命
                    ],
                },
                mcpOAuth: {
                    // MCP OAuth 凭据密文（该 API 始终返回空字符串）
                    type: 'string',
                    description: 'Encrypted MCP OAuth credentials (always an empty string in this API)',
                },
                notebookCrypto: {
                    // 加密笔记本相关设置项
                    $ref: '#/$defs/notebookCrypto',
                },
                oidc: {
                    // OpenID Connect 登录相关设置项
                    $ref: '#/$defs/oidc',
                },
                onboarding: {
                    // 新手引导状态
                    $ref: '#/$defs/onboarding',
                },
                publish: {
                    // 发布服务相关设置项
                    $ref: '#/$defs/publish',
                },
                readonly: {
                    // 是否是以只读模式运行
                    type: 'boolean',
                    description: 'Whether it is running in read-only mode',
                },
                repo: {
                    // 快照仓库相关设置项
                    $ref: '#/$defs/repo',
                },
                search: {
                    // 搜索相关设置项
                    $ref: '#/$defs/search',
                },
                secrets: {
                    // 全局密钥库
                    $ref: '#/$defs/secrets',
                },
                serverAddrs: {
                    // 内核服务地址列表（局域网 IPv4 地址与 127.0.0.1），非管理员角色为空列表
                    type: 'array',
                    description: 'Kernel server addresses (LAN IPv4 addresses and 127.0.0.1), empty for non-administrator roles',
                    items: {
                        type: 'string',
                        description: 'Kernel server address',
                        examples: [
                            'http://127.0.0.1:6806',
                            'http://192.168.1.2:6806',
                        ],
                    },
                },
                showChangelog: {
                    // 是否显示本版本更新日志
                    type: 'boolean',
                    description: 'Whether to display the changelog for this release version',
                },
                snippet: {
                    // 代码片段相关设置项
                    $ref: '#/$defs/snippet',
                },
                stat: {
                    // 工作空间内容统计
                    $ref: '#/$defs/stat',
                },
                sync: {
                    // 同步相关设置项
                    $ref: '#/$defs/sync',
                },
                system: {
                    // 系统相关信息
                    $ref: '#/$defs/system',
                },
                tag: {
                    // 思源标签面板相关设置项
                    $ref: '#/$defs/tag',
                },
                uiLayout: {
                    // 思源界面布局相关配置项
                    $ref: '#/$defs/uiLayout',
                },
                userData: {
                    // 社区用户信息
                    type: 'string',
                    description: 'Community user data (Encrypted)',
                    default: '',
                },
                variables: {
                    // 全局变量库
                    $ref: '#/$defs/variables',
                },
            },
        },
        ai: {
            title: 'IAI',
            type: 'object',

            description: 'Artificial Intelligence (AI) related configuration',
            additionalProperties: false,
            required: [
                'agent',
                'decision',
                'editing',
                'embedding',
                'imageGeneration',
                'mcp',
                'providers',
                'rerank',
            ],
            properties: {
                agent: {
                    // 智能体设置项
                    $ref: '#/$defs/ai_agent',
                },
                decision: {
                    // 决策模型设置项
                    $ref: '#/$defs/ai_decision',
                },
                editing: {
                    // 编辑器内 AI 设置项
                    $ref: '#/$defs/ai_editing',
                },
                embedding: {
                    // 向量模型设置项
                    $ref: '#/$defs/ai_embedding',
                },
                imageGeneration: {
                    // 图片生成设置项
                    $ref: '#/$defs/ai_imageGeneration',
                },
                mcp: {
                    // MCP 设置项
                    $ref: '#/$defs/ai_mcp',
                },
                providers: {
                    // 模型服务商列表
                    type: 'array',
                    description: 'Model providers',
                    items: {
                        $ref: '#/$defs/ai_provider',
                    },
                },
                rerank: {
                    // 重排模型设置项
                    $ref: '#/$defs/ai_rerank',
                },
            },
        },
        ai_agent: {
            title: 'IAIAgent',
            type: 'object',

            description: 'AI agent configuration',
            additionalProperties: false,
            required: [
                'approvalPolicy',
                'capabilityPolicy',
                'confirmTimeout',
                'maxCompletionTokens',
                'maxRetries',
                'maxToolCallRounds',
                'modelId',
                'sessionTimeout',
                'skills',
                'streamIdleTimeout',
                'temperature',
            ],
            properties: {
                approvalPolicy: {
                    // 工具调用审批策略
                    $ref: '#/$defs/ai_agent_approvalPolicy',
                },
                capabilityPolicy: {
                    // 智能体可用的能力（工具）策略
                    $ref: '#/$defs/ai_capabilityPolicy',
                },
                confirmTimeout: {
                    // 等待用户确认或回答提问的超时时间（单位: s），0 表示不限时
                    type: 'integer',
                    description: 'Timeout for waiting for user confirmations and answers (unit: s), `0` means no limit',
                    default: 600,
                },
                maxCompletionTokens: {
                    // 单次回复的最大输出 token 数，0 表示不设置
                    type: 'integer',
                    description: 'Maximum output tokens per reply, `0` means not set',
                    default: 0,
                },
                maxRetries: {
                    // 模型请求失败时的重试次数
                    type: 'integer',
                    description: 'Retries for failed model requests',
                    default: 3,
                    minimum: 0,
                    maximum: 10,
                },
                maxToolCallRounds: {
                    // 单轮对话的最大工具调用轮数，小于等于 0 表示不限
                    type: 'integer',
                    description: 'Maximum tool call rounds per user turn, `0` or less means unlimited',
                    default: 64,
                },
                modelId: {
                    // 智能体使用的模型 ID（ai.providers[].models[].id）
                    type: 'string',
                    description: 'ID of the model used by the agent (`ai.providers[].models[].id`)',
                },
                sessionTimeout: {
                    // 会话总超时时间（单位: s），0 表示不限
                    type: 'integer',
                    description: 'Total session timeout (unit: s), `0` means unlimited',
                    default: 1800,
                    minimum: 0,
                    maximum: 3600,
                },
                skills: {
                    // 技能设置项
                    $ref: '#/$defs/ai_agent_skills',
                },
                streamIdleTimeout: {
                    // 流式输出空闲超时时间（单位: s），持续无输出时中断
                    type: 'integer',
                    description: 'Streaming idle timeout (unit: s), the reply is aborted when no output arrives within it',
                    default: 120,
                    minimum: 1,
                    maximum: 600,
                },
                temperature: {
                    // 采样温度
                    type: 'number',
                    description: 'Sampling temperature',
                    default: 1,
                    minimum: 0,
                    maximum: 2,
                },
            },
        },
        ai_agent_approvalPolicy: {
            title: 'IAIAgentApprovalPolicy',
            type: 'object',

            description: 'Approval policy for agent tool calls',
            additionalProperties: false,
            required: [
                'default',
                'overrides',
            ],
            properties: {
                default: {
                    // 全局审批方式
                    type: 'string',
                    title: 'TAIAgentApprovalPolicyDefault',
                    description: 'Global approval mode\n- `risk`: Ask for confirmation according to the operation risk\n- `allow`: Approve automatically',
                    default: 'risk',
                    enum: [
                        'allow', // 自动批准
                        'risk', // 按操作风险决定是否确认
                    ],
                },
                overrides: {
                    // 按能力 ID 覆盖的审批方式，键如 native/backend/<工具名>、mcp/backend/<服务器 ID>/<工具名>
                    type: 'object',
                    description: 'Approval overrides keyed by capability ID, such as `native/backend/<tool>` or `mcp/backend/<server ID>/<tool>`',
                    additionalProperties: {
                        $ref: '#/$defs/ai_agent_capabilityApproval',
                    },
                },
            },
        },
        ai_agent_capabilityApproval: {
            title: 'IAIAgentCapabilityApproval',
            type: 'object',

            description: 'Approval override of a capability',
            additionalProperties: false,
            required: [
                'actions',
                'default',
            ],
            properties: {
                actions: {
                    // 按工具 action 参数值细分的审批方式
                    type: 'object',
                    description: 'Approval modes by the value of the `action` argument of the tool',
                    additionalProperties: {
                        $ref: '#/$defs/ai_agent_approval',
                    },
                },
                default: {
                    // 该能力的审批方式，空字符串表示继承全局设置
                    type: 'string',
                    title: 'TAIAgentApprovalOverride',
                    description: 'Approval mode of the capability, an empty string inherits the global mode\n- `allow`: Approve automatically\n- `confirm`: Always ask for confirmation\n- `risk`: Ask for confirmation according to the operation risk',
                    enum: [
                        '', // 继承全局设置
                        'allow', // 自动批准
                        'confirm', // 总是确认
                        'risk', // 按操作风险决定是否确认
                    ],
                },
            },
        },
        ai_agent_approval: {
            title: 'TAIAgentApproval',
            type: 'string',

            description: 'Approval mode\n- `allow`: Approve automatically\n- `confirm`: Always ask for confirmation\n- `risk`: Ask for confirmation according to the operation risk',
            enum: [
                'allow', // 自动批准
                'confirm', // 总是确认
                'risk', // 按操作风险决定是否确认
            ],
        },
        ai_agent_skills: {
            title: 'IAIAgentSkills',
            type: 'object',

            description: 'Agent skills configuration',
            additionalProperties: false,
            required: [
                'userEnabled',
            ],
            properties: {
                userEnabled: {
                    // 已启用的用户级技能（~/.agents/skills 下的目录名）
                    type: 'array',
                    description: 'Enabled user-level skills (directory names under `~/.agents/skills`)',
                    items: {
                        type: 'string',
                    },
                },
            },
        },
        ai_capabilityPolicy: {
            title: 'IAICapabilityPolicy',
            type: 'object',

            description: 'Policy of which capabilities (tools) are available',
            additionalProperties: false,
            required: [
                'default',
                'overrides',
            ],
            properties: {
                default: {
                    // 默认策略
                    $ref: '#/$defs/ai_capabilityPolicy_value',
                },
                overrides: {
                    // 按能力 ID 覆盖的策略
                    type: 'object',
                    description: 'Policy overrides keyed by capability ID',
                    additionalProperties: {
                        $ref: '#/$defs/ai_capabilityPolicy_value',
                    },
                },
            },
        },
        ai_capabilityPolicy_value: {
            title: 'TAICapabilityPolicy',
            type: 'string',

            description: 'Capability policy\n- `allow`: Available\n- `deny`: Unavailable',
            enum: [
                'allow', // 允许
                'deny', // 禁止
            ],
        },
        ai_decision: {
            title: 'IAIDecision',
            type: 'object',

            description: 'Decision model (TypeSafe System One) configuration, which provides the decision tool to the agent',
            additionalProperties: false,
            required: [
                'apiKey',
                'enabled',
                'endpoint',
                'name',
                'timeout',
            ],
            properties: {
                apiKey: {
                    // API 密钥
                    type: 'string',
                    description: 'API key',
                },
                enabled: {
                    // 是否启用决策模型
                    type: 'boolean',
                    description: 'Whether to enable the decision model',
                },
                endpoint: {
                    // 服务端点
                    type: 'string',
                    description: 'Service endpoint',
                    default: 'https://api.typesafe.ai/v1/systemone',
                },
                name: {
                    // 模型名称
                    type: 'string',
                    description: 'Model name',
                    default: 'jev-latest',
                },
                timeout: {
                    // 请求超时时间（单位: s）
                    type: 'integer',
                    description: 'Request timeout (unit: s)',
                    default: 30,
                    minimum: 1,
                    maximum: 600,
                },
            },
        },
        ai_editing: {
            title: 'IAIEditing',
            type: 'object',

            description: 'In-editor AI configuration',
            additionalProperties: false,
            required: [
                'maxCompletionTokens',
                'maxHistoryMessages',
                'modelId',
                'temperature',
            ],
            properties: {
                maxCompletionTokens: {
                    // 单次回复的最大输出 token 数，0 表示不设置
                    type: 'integer',
                    description: 'Maximum output tokens per reply, `0` means not set',
                    default: 0,
                },
                maxHistoryMessages: {
                    // 作为上下文保留的历史对话轮数
                    type: 'integer',
                    description: 'Number of previous turns kept as context',
                    default: 7,
                    minimum: 1,
                    maximum: 64,
                },
                modelId: {
                    // 使用的模型 ID（ai.providers[].models[].id）
                    type: 'string',
                    description: 'ID of the model used (`ai.providers[].models[].id`)',
                },
                temperature: {
                    // 采样温度
                    type: 'number',
                    description: 'Sampling temperature',
                    default: 1,
                    minimum: 0,
                    maximum: 2,
                },
            },
        },
        ai_embedding: {
            title: 'IAIEmbedding',
            type: 'object',

            description: 'Embedding model configuration, used for recall in semantic search',
            additionalProperties: false,
            required: [
                'apiKey',
                'baseURL',
                'dimensions',
                'enabled',
                'id',
                'name',
                'timeout',
            ],
            properties: {
                apiKey: {
                    // API 密钥
                    type: 'string',
                    description: 'API key',
                },
                baseURL: {
                    // API 基础地址
                    type: 'string',
                    description: 'API base URL',
                },
                dimensions: {
                    // 输出向量维度，0 表示使用模型的默认维度
                    type: 'integer',
                    description: 'Dimensions of the output vectors, `0` means the default of the model',
                    default: 0,
                },
                enabled: {
                    // 是否启用向量化
                    type: 'boolean',
                    description: 'Whether to enable embeddings',
                },
                id: {
                    // 配置 ID
                    type: 'string',
                    description: 'Configuration ID',
                },
                name: {
                    // 模型名称
                    type: 'string',
                    description: 'Model name',
                },
                timeout: {
                    // 请求超时时间（单位: s）
                    type: 'integer',
                    description: 'Request timeout (unit: s)',
                    default: 30,
                },
            },
        },
        ai_imageGeneration: {
            title: 'IAIImageGeneration',
            type: 'object',

            description: 'Image generation configuration',
            additionalProperties: false,
            required: [
                'modelId',
                'outputFormat',
                'quality',
                'requestTimeout',
                'size',
            ],
            properties: {
                modelId: {
                    // 使用的模型 ID（ai.providers[].models[].id），可以为空
                    type: 'string',
                    description: 'ID of the model used (`ai.providers[].models[].id`), may be empty',
                },
                outputFormat: {
                    // 输出图片格式
                    type: 'string',
                    title: 'TAIImageGenerationOutputFormat',
                    description: 'Output image format',
                    default: 'png',
                    enum: [
                        'jpeg',
                        'png',
                        'webp',
                    ],
                },
                quality: {
                    // 默认图片质量，原样传给服务商
                    type: 'string',
                    description: 'Default image quality, passed to the provider as is',
                    default: 'auto',
                },
                requestTimeout: {
                    // 请求超时时间（单位: s）
                    type: 'integer',
                    description: 'Request timeout (unit: s)',
                    default: 300,
                    minimum: 1,
                    maximum: 600,
                },
                size: {
                    // 默认图片尺寸，原样传给服务商
                    type: 'string',
                    description: 'Default image size, passed to the provider as is',
                    default: '1024x1024',
                },
            },
        },
        ai_mcp: {
            title: 'IAIMcp',
            type: 'object',

            description: 'MCP (Model Context Protocol) configuration',
            additionalProperties: false,
            required: [
                'exposurePolicy',
                'servers',
            ],
            properties: {
                exposurePolicy: {
                    // 内置 MCP 服务向外部客户端暴露的工具策略
                    $ref: '#/$defs/ai_capabilityPolicy',
                },
                servers: {
                    // 智能体连接的外部 MCP 服务器列表
                    type: 'array',
                    description: 'External MCP servers the agent connects to',
                    items: {
                        $ref: '#/$defs/ai_mcp_server',
                    },
                },
            },
        },
        ai_mcp_server: {
            title: 'IAIMCPServer',
            type: 'object',

            description: 'External MCP server',
            additionalProperties: false,
            required: [
                'args',
                'command',
                'disableStandaloneSSE',
                'enabled',
                'env',
                'headers',
                'id',
                'inheritEnv',
                'name',
                'timeout',
                'trustToolAnnotations',
                'type',
                'url',
            ],
            properties: {
                args: {
                    // 命令参数（stdio）
                    type: 'array',
                    description: 'Command arguments (stdio)',
                    items: {
                        type: 'string',
                    },
                },
                command: {
                    // 启动的可执行命令（stdio）
                    type: 'string',
                    description: 'Executable to launch (stdio)',
                },
                disableStandaloneSSE: {
                    // 是否关闭 Streamable HTTP 的独立 SSE 流
                    type: 'boolean',
                    description: 'Whether to disable the standalone SSE stream of Streamable HTTP',
                },
                enabled: {
                    // 是否启用该服务器
                    type: 'boolean',
                    description: 'Whether to enable the server',
                },
                env: {
                    // 子进程的环境变量（stdio），支持 {{secrets.X}} 与 {{vars.X}}
                    type: 'object',
                    description: 'Environment variables of the process (stdio), supporting `{{secrets.X}}` and `{{vars.X}}`',
                    additionalProperties: {
                        type: 'string',
                    },
                },
                headers: {
                    // HTTP 请求头（http），支持密钥与变量占位符
                    type: 'object',
                    description: 'HTTP request headers (http), supporting secret and variable placeholders',
                    additionalProperties: {
                        type: 'string',
                    },
                },
                id: {
                    // 服务器 ID
                    type: 'string',
                    description: 'Server ID (UUID)',
                },
                inheritEnv: {
                    // 允许从内核进程继承的环境变量名（stdio）
                    type: 'array',
                    description: 'Names of environment variables inherited from the kernel process (stdio)',
                    items: {
                        type: 'string',
                    },
                },
                name: {
                    // 显示名称
                    type: 'string',
                    description: 'Display name',
                },
                timeout: {
                    // 连接、列举工具与调用工具的超时时间（单位: s），小于等于 0 时为 30
                    type: 'integer',
                    description: 'Timeout for connecting, listing tools and calling tools (unit: s), `30` when `0` or less',
                },
                trustToolAnnotations: {
                    // 是否信任服务器声明的只读提示（readOnlyHint）
                    type: 'boolean',
                    description: 'Whether to trust the `readOnlyHint` annotations declared by the server',
                },
                type: {
                    // 传输方式
                    type: 'string',
                    title: 'TAIMCPServerType',
                    description: 'Transport type',
                    enum: [
                        'http',
                        'stdio',
                    ],
                },
                url: {
                    // 服务地址（http）
                    type: 'string',
                    description: 'Server URL (http)',
                },
            },
        },
        ai_provider: {
            title: 'IAIProvider',
            type: 'object',

            description: 'Model provider',
            additionalProperties: false,
            required: [
                'apiKey',
                'baseURL',
                'enabled',
                'id',
                'models',
                'requestTimeout',
            ],
            properties: {
                apiKey: {
                    // API 密钥
                    type: 'string',
                    description: 'API key',
                },
                baseURL: {
                    // API 基础地址，为空时使用 OpenAI（anthropic-messages 协议为 Anthropic）的官方地址
                    type: 'string',
                    description: 'API base URL, the official OpenAI URL (Anthropic URL for `anthropic-messages`) when empty',
                },
                displayName: {
                    // 显示名称
                    type: 'string',
                    description: 'Display name',
                },
                enabled: {
                    // 是否启用该服务商
                    type: 'boolean',
                    description: 'Whether to enable the provider',
                },
                headers: {
                    // 自定义请求头，支持密钥与变量占位符
                    type: 'object',
                    description: 'Custom request headers, supporting secret and variable placeholders',
                    additionalProperties: {
                        type: 'string',
                    },
                },
                id: {
                    // 服务商 ID
                    type: 'string',
                    description: 'Provider ID',
                },
                models: {
                    // 模型列表
                    type: 'array',
                    description: 'Models',
                    items: {
                        $ref: '#/$defs/ai_provider_model',
                    },
                },
                protocol: {
                    // 接口协议
                    type: 'string',
                    title: 'TAIProviderProtocol',
                    description: 'API protocol\n- `openai`: OpenAI Chat Completions\n- `openai-responses`: OpenAI Responses\n- `anthropic-messages`: Anthropic Messages',
                    default: 'openai',
                    enum: [
                        'anthropic-messages',
                        'openai',
                        'openai-responses',
                    ],
                },
                requestTimeout: {
                    // 请求超时时间（单位: s）
                    type: 'integer',
                    description: 'Request timeout (unit: s)',
                    default: 120,
                    minimum: 1,
                    maximum: 600,
                },
            },
        },
        ai_provider_model: {
            title: 'IAIProviderModel',
            type: 'object',

            description: 'Model of a provider',
            additionalProperties: false,
            required: [
                'enabled',
                'id',
                'name',
            ],
            properties: {
                contextLength: {
                    // 上下文窗口大小（token），0 表示自动推断
                    type: 'integer',
                    description: 'Context window size (tokens), `0` means inferred automatically',
                },
                displayName: {
                    // 显示名称
                    type: 'string',
                    description: 'Display name',
                },
                enabled: {
                    // 是否启用该模型
                    type: 'boolean',
                    description: 'Whether to enable the model',
                },
                id: {
                    // 模型条目 ID，供各处的 modelId 引用
                    type: 'string',
                    description: 'Model entry ID, referenced by the `modelId` fields',
                },
                name: {
                    // 调用 API 时使用的模型名称
                    type: 'string',
                    description: 'Model name sent to the API',
                },
            },
        },
        ai_rerank: {
            title: 'IAIRerank',
            type: 'object',

            description: 'Rerank model configuration, used to rerank semantic search results',
            additionalProperties: false,
            required: [
                'apiKey',
                'candidateCount',
                'enabled',
                'endpoint',
                'id',
                'name',
                'requestFormat',
                'timeout',
            ],
            properties: {
                apiKey: {
                    // API 密钥
                    type: 'string',
                    description: 'API key',
                },
                candidateCount: {
                    // 向量召回后送去重排的候选数量
                    type: 'integer',
                    description: 'Number of candidates sent to rerank after vector recall',
                    default: 30,
                    minimum: 5,
                    maximum: 100,
                },
                enabled: {
                    // 是否启用重排
                    type: 'boolean',
                    description: 'Whether to enable reranking',
                },
                endpoint: {
                    // 完整的重排服务端点
                    type: 'string',
                    description: 'Full endpoint URL of the rerank service',
                },
                id: {
                    // 配置 ID
                    type: 'string',
                    description: 'Configuration ID',
                },
                name: {
                    // 模型名称
                    type: 'string',
                    description: 'Model name',
                },
                requestFormat: {
                    // 请求格式
                    type: 'string',
                    title: 'TAIRerankRequestFormat',
                    description: 'Request format',
                    default: 'cohere',
                    enum: [
                        'cohere',
                        'dashscope',
                    ],
                },
                timeout: {
                    // 请求超时时间（单位: s）
                    type: 'integer',
                    description: 'Request timeout (unit: s)',
                    default: 30,
                },
            },
        },
        api: {
            title: 'IApi',
            type: 'object',

            description: 'SiYuan API related configuration',
            additionalProperties: false,
            required: [
                'token',
            ],
            properties: {
                token: {
                    type: 'string',
                    description: 'API Token',
                    examples: [
                        '',
                        '0123456789abcdef',
                    ],
                },
            },
        },
        appearance: {
            title: 'IAppearance',
            type: 'object',

            description: 'SiYuan appearance related configuration',
            additionalProperties: false,
            required: [
                'bodyGradient',
                'closeButtonBehavior',
                'codeBlockThemeDark',
                'codeBlockThemeLight',
                'darkThemes',
                'entryVisibility',
                'globalFontFamilies',
                'hideStatusBar',
                'hideToolbar',
                'icon',
                'iconVer',
                'icons',
                'lang',
                'lightThemes',
                'mode',
                'modeOS',
                'notifications',
                'statusBar',
                'themeDark',
                'themeJS',
                'themeLight',
                'themeVer',
            ],
            properties: {
                bodyGradient: {
                    // 背景渐变，为 null 时按工作空间名称自动配色
                    description: 'Body background gradient, colors are derived from the workspace name when `null`',
                    oneOf: [
                        {
                            type: 'null',
                        },
                        {
                            $ref: '#/$defs/appearance_bodyGradient',
                        },
                    ],
                },
                closeButtonBehavior: {
                    // 关闭按钮行为
                    type: 'integer',
                    description: 'Close button behavior\n- `0`: Exit application\n- `1`: Minimize to pallets',
                    enum: [
                        0, // 退出应用
                        1, // 最小化到托盘
                    ],
                },
                codeBlockThemeDark: {
                    // 暗色代码块主题
                    type: 'string',
                    description: 'Dark code block theme',
                },
                codeBlockThemeLight: {
                    // 亮色代码块主题
                    type: 'string',
                    description: 'Light code block theme',
                },
                darkThemes: {
                    // 已安装的暗色主题名称列表
                    type: 'array',
                    description: 'List of installed dark themes',
                    items: {
                        $ref: '#/$defs/appearance_theme_item',
                    },
                },
                entryVisibility: {
                    // 桌面端界面入口（顶栏、状态栏、菜单、工具栏与停靠栏各项）的显示与排序方案
                    $ref: '#/$defs/appearance_entryVisibility',
                },
                globalFontFamilies: {
                    // 全局默认字体，按优先级从高到低排列
                    type: 'array',
                    description: 'Global default fonts in descending order of priority',
                    items: {
                        $ref: '#/$defs/font',
                    },
                },
                hideStatusBar: {
                    // 是否隐藏状态栏
                    type: 'boolean',
                    description: 'Whether to hide status bar',
                },
                hideToolbar: {
                    // 是否将页签栏融合至顶栏
                    type: 'boolean',
                    description: 'Whether to merge the tab bar into the top bar',
                    default: true,
                },
                icon: {
                    // 当前使用的图标名称
                    type: 'string',
                    description: 'The name of the icon currently in use',
                },
                iconVer: {
                    // 当前使用的图标的版本号
                    type: 'string',
                    description: 'The version number of the icon currently in use',
                },
                icons: {
                    // 已安装的图标列表
                    type: 'array',
                    description: 'List of installed icons',
                    items: {
                        $ref: '#/$defs/appearance_icon_item',
                    },
                },
                lang: {
                    // 当前用户界面所使用的语言
                    type: 'string',
                    title: 'TLang',
                    description: 'The language used by the current user',
                    enum: [
                        'ar', // 阿拉伯文
                        'de', // 德文
                        'en', // 英文
                        'es', // 西班牙文
                        'fr', // 法文
                        'he', // 希伯来文
                        'hi', // 印地文
                        'id', // 印度尼西亚文
                        'it', // 意大利文
                        'ja', // 日文
                        'ko', // 韩文
                        'nl', // 荷兰文
                        'pl', // 波兰文
                        'pt-BR', // 巴西葡萄牙文
                        'ru', // 俄文
                        'sk', // 斯洛伐克文
                        'sr', // 塞尔维亚文
                        'th', // 泰文
                        'tr', // 土耳其文
                        'uk', // 乌克兰文
                        'zh-CN', // 简体中文
                        'zh-TW', // 繁体中文
                    ],
                },
                lightThemes: {
                    // 已安装的亮色主题名称列表
                    type: 'array',
                    description: 'List of installed light themes',
                    items: {
                        $ref: '#/$defs/appearance_theme_item',
                    },
                },
                mode: {
                    // 当前使用的主题模式
                    type: 'integer',
                    description: 'The current theme mode\n- `0`: Light theme\n- `1`: Dark theme',
                    enum: [
                        0, // 亮色主题
                        1, // 暗色主题
                    ],
                },
                modeOS: {
                    // 主题模式是否跟随系统主题
                    type: 'boolean',
                    description: 'Whether the theme mode follows the system theme',
                },
                notifications: {
                    // 内置通知与提示的开关
                    $ref: '#/$defs/appearance_notifications',
                },
                statusBar: {
                    // 状态栏消息的开关
                    $ref: '#/$defs/appearance_statusBar',
                },
                themeDark: {
                    // 当前使用的暗色主题名称
                    type: 'string',
                    description: 'The name of the dark theme currently in use',
                },
                themeJS: {
                    // 当前主题是否启用了主题 JavaScript
                    type: 'boolean',
                    description: 'Whether the current theme has enabled theme JavaScript',
                },
                themeLight: {
                    // 当前使用的亮色主题名称
                    type: 'string',
                    description: 'The name of the light theme currently in use',
                },
                themeVer: {
                    // 当前使用的主题的版本号
                    type: 'string',
                    description: 'The version number of the theme currently in use',
                },
            },
        },
        appearance_theme_item: {
            title: 'IAppearanceThemeItem',
            description: 'Theme item',

            type: 'object',
            additionalProperties: false,
            required: [
                'label',
                'name',
            ],
            properties: {
                frontends: {
                    // 主题声明支持的前端（all、desktop、desktop-window、mobile、browser-desktop、browser-mobile），缺省时支持除 mobile 与 browser-mobile 外的所有前端
                    type: 'array',
                    description: 'Frontends supported by the theme (`all`, `desktop`, `desktop-window`, `mobile`, `browser-desktop`, `browser-mobile`), all frontends except `mobile` and `browser-mobile` when omitted',
                    items: {
                        type: 'string',
                    },
                },
                label: {
                    // 外观主题标注
                    type: 'string',
                    description: 'Appearance theme label',
                },
                name: {
                    // 外观主题名称
                    type: 'string',
                    description: 'Appearance theme name',
                },
            },
        },
        appearance_bodyGradient: {
            title: 'IAppearanceBodyGradient',
            type: 'object',

            description: 'Body background gradient',
            additionalProperties: false,
            required: [
                'dark',
                'light',
                'mode',
            ],
            properties: {
                dark: {
                    // 暗色模式下的渐变颜色
                    $ref: '#/$defs/appearance_bodyGradient_color',
                },
                light: {
                    // 亮色模式下的渐变颜色
                    $ref: '#/$defs/appearance_bodyGradient_color',
                },
                mode: {
                    // 渐变模式
                    type: 'string',
                    title: 'TAppearanceBodyGradientMode',
                    description: 'Gradient mode\n- `auto`: Automatic\n- `custom`: Custom\n- `off`: Off',
                    enum: [
                        'auto', // 自动
                        'custom', // 自定义
                        'off', // 关闭
                    ],
                },
            },
        },
        appearance_bodyGradient_color: {
            title: 'IAppearanceBodyGradientColor',
            type: 'object',

            description: 'Gradient color',
            additionalProperties: false,
            required: [
                'color',
                'opacity',
            ],
            properties: {
                color: {
                    // 渐变颜色（十六进制 RGB）
                    type: 'string',
                    description: 'Gradient color (hex RGB)',
                },
                opacity: {
                    // 渐变起点的不透明度
                    type: 'number',
                    description: 'Opacity at the start of the gradient',
                    minimum: 0,
                    maximum: 100,
                },
            },
        },
        appearance_entryVisibility: {
            title: 'IAppearanceEntryVisibility',
            type: 'object',

            description: 'Visibility and order of desktop UI entries (top bar, status bar, menus, toolbars and docks)',
            additionalProperties: false,
            required: [
                'active',
                'profiles',
                'version',
            ],
            properties: {
                active: {
                    // 当前方案 ID：内置的 simple、full 或自定义方案的 ID
                    type: 'string',
                    description: 'ID of the active profile: the built-in `simple` or `full`, or the ID of a custom profile',
                    examples: [
                        'simple',
                        'full',
                    ],
                },
                profiles: {
                    // 自定义方案列表（不含内置方案）
                    type: 'array',
                    description: 'Custom profiles (the built-in profiles are not included)',
                    items: {
                        $ref: '#/$defs/appearance_entryVisibility_profile',
                    },
                },
                version: {
                    // 配置结构版本
                    type: 'integer',
                    description: 'Version of the configuration structure',
                },
            },
        },
        appearance_entryVisibility_profile: {
            title: 'IAppearanceEntryVisibilityProfile',
            type: 'object',

            description: 'Custom profile of entry visibility and order',
            additionalProperties: false,
            required: [
                'entries',
                'id',
                'name',
                'orders',
            ],
            properties: {
                entries: {
                    // 入口路径（如 document.more.editMode）到是否显示的映射，未列出的入口按默认可见性显示
                    type: 'object',
                    description: 'Map from entry paths (such as `document.more.editMode`) to visibility, unlisted entries use their default visibility',
                    additionalProperties: {
                        type: 'boolean',
                    },
                },
                id: {
                    // 方案 ID
                    type: 'string',
                    description: 'Profile ID',
                },
                name: {
                    // 方案名称
                    type: 'string',
                    description: 'Profile name',
                },
                orders: {
                    // 父入口路径到下级入口顺序的映射
                    type: 'object',
                    description: 'Map from parent entry paths to the order of their child entries',
                    additionalProperties: {
                        type: 'array',
                        items: {
                            type: 'string',
                        },
                    },
                },
            },
        },
        appearance_icon_item: {
            title: 'IAppearanceIconItem',
            description: 'Icon item',

            type: 'object',
            additionalProperties: false,
            required: [
                'label',
                'name',
            ],
            properties: {
                label: {
                    // 图标显示名称
                    type: 'string',
                    description: 'Icon label',
                    examples: [
                        'litheness (Default)',
                    ],
                },
                name: {
                    // 图标名称（目录名）
                    type: 'string',
                    description: 'Icon name (directory name)',
                    examples: [
                        'litheness',
                    ],
                },
            },
        },
        appearance_notifications: {
            title: 'IAppearanceNotifications',
            type: 'object',

            description: 'Switches of built-in notifications and tips',
            additionalProperties: false,
            required: [
                'browserCompatibility',
                'docTreeMaxList',
                'tagMaxList',
                'workspaceNotSSD',
            ],
            properties: {
                browserCompatibility: {
                    // 是否显示浏览器兼容性提示
                    type: 'boolean',
                    description: 'Whether to show the browser compatibility notice',
                },
                docTreeMaxList: {
                    // 文档树展开的文档数量达到上限时是否提示
                    type: 'boolean',
                    description: 'Whether to notify when the number of documents expanded in the document tree reaches the limit',
                },
                formatPainterTip: {
                    // 是否显示格式刷的使用提示，缺省时显示
                    type: 'boolean',
                    description: 'Whether to show the tip of the format painter, shown when omitted',
                },
                selectAllIncompleteTip: {
                    // 编辑器全选不完整时是否提示，缺省时提示
                    type: 'boolean',
                    description: 'Whether to show a tip when select-all in the editor is incomplete, shown when omitted',
                },
                selectAllTip: {
                    // 是否显示编辑器全选提示，缺省时显示
                    type: 'boolean',
                    description: 'Whether to show the tip of select-all in the editor, shown when omitted',
                },
                tagMaxList: {
                    // 标签面板展开的标签数量达到上限时是否提示
                    type: 'boolean',
                    description: 'Whether to notify when the number of tags expanded in the tag panel reaches the limit',
                },
                workspaceNotSSD: {
                    // 工作空间不在固态硬盘上时是否警告
                    type: 'boolean',
                    description: 'Whether to warn when the workspace is not on an SSD',
                },
            },
        },
        appearance_statusBar: {
            title: 'IAppearanceStatusBar',
            type: 'object',

            description: 'Switches of status bar messages',
            additionalProperties: false,
            required: [
                'msgDataSyncDisabled',
                'msgTaskAssetDatabaseIndexCommitDisabled',
                'msgTaskDatabaseIndexCommitDisabled',
                'msgTaskHistoryDatabaseIndexCommitDisabled',
                'msgTaskHistoryGenerateFileDisabled',
                'version',
            ],
            properties: {
                msgDataSyncDisabled: {
                    // 是否不显示数据同步消息
                    type: 'boolean',
                    description: 'Whether to hide data sync messages',
                },
                msgTaskAssetDatabaseIndexCommitDisabled: {
                    // 是否不显示资源文件内容索引提交任务的消息
                    type: 'boolean',
                    description: 'Whether to hide messages of asset content index commit tasks',
                },
                msgTaskDatabaseIndexCommitDisabled: {
                    // 是否不显示数据库索引提交任务的消息
                    type: 'boolean',
                    description: 'Whether to hide messages of database index commit tasks',
                },
                msgTaskHistoryDatabaseIndexCommitDisabled: {
                    // 是否不显示历史数据库索引提交任务的消息
                    type: 'boolean',
                    description: 'Whether to hide messages of history database index commit tasks',
                },
                msgTaskHistoryGenerateFileDisabled: {
                    // 是否不显示生成历史文件任务的消息
                    type: 'boolean',
                    description: 'Whether to hide messages of history file generation tasks',
                },
                version: {
                    // 配置结构版本
                    type: 'integer',
                    description: 'Version of the configuration structure',
                },
            },
        },
        bazaar: {
            title: 'IBazaar',
            type: 'object',

            description: 'SiYuan bazaar related configuration',
            additionalProperties: false,
            required: [
                'petalDisabled',
                'trust',
            ],
            properties: {
                petalDisabled: {
                    // 是否禁用所有插件
                    type: 'boolean',
                    description: 'Whether to disable all plug-ins',
                },
                trust: {
                    // 是否信任(启用)集市资源
                    type: 'boolean',
                    description: 'Whether to trust (enable) the resources for the bazaar',
                },
            },
        },
        editor: {
            title: 'IEditor',
            type: 'object',

            description: 'SiYuan editor related configuration',
            additionalProperties: false,
            required: [
                'allowHTMLBLockScript',
                'allowSVGScript',
                'assetOpen',
                'autoDirection',
                'backlinkBlockSort',
                'backlinkContainChildren',
                'backlinkExpandCount',
                'backlinkGlobalSort',
                'backlinkHideReference',
                'backlinkMentionExclude',
                'backlinkShowBottom',
                'backlinkSort',
                'backmentionExpandCount',
                'backmentionSort',
                'blockRefDynamicAnchorTextMaxLen',
                'checkBlockRef',
                'codeFontFamilies',
                'codeLigatures',
                'codeLineWrap',
                'codeSyntaxHighlightLineNum',
                'codeTabSpaces',
                'cursorSurroundingLines',
                'databaseAttrClickMode',
                'databaseAttrHideEmpty',
                'databaseAttrShow',
                'databaseAttrUseTabs',
                'databaseAttrViewMode',
                'displayBookmarkIcon',
                'displayNetImgMark',
                'dragHTMLFileToIframe',
                'dynamicLoadBlocks',
                'embedBlockBreadcrumb',
                'emoji',
                'floatWindowDelay',
                'floatWindowMode',
                'fontFamilies',
                'fontFamily',
                'fontFamilyDisplay',
                'fontSize',
                'fontSizeScrollZoom',
                'fontWeight',
                'fullWidth',
                'generateHistoryInterval',
                'hashTagSearch',
                'headingEmbedMode',
                'headingNumber',
                'headingNumberFormat',
                'historyRetentionDays',
                'justify',
                'katexMacros',
                'keepLoadedContent',
                'listItemDotNumberClickFocus',
                'listLogicalOutdent',
                'markdown',
                'onlySearchForDoc',
                'pasteURLAutoConvert',
                'plantUMLServePath',
                'readOnly',
                'rtl',
                'spellcheck',
                'spellcheckLanguages',
                'virtualBlockRef',
                'virtualBlockRefExclude',
                'virtualBlockRefInclude',
            ],
            properties: {
                allowHTMLBLockScript: {
                    // 是否允许 HTML 块运行脚本
                    type: 'boolean',
                    description: 'Allow HTML blocks to run scripts',
                },
                allowSVGScript: {
                    // 是否允许执行 SVG 图片中的脚本
                    type: 'boolean',
                    description: 'Whether to allow scripts in SVG images to run',
                },
                assetOpen: {
                    // 点击资源文件时的打开方式
                    $ref: '#/$defs/editor_assetOpen',
                },
                autoDirection: {
                    // 是否自动判定段落与标题的文字方向（手动设置的方向优先）
                    type: 'boolean',
                    description: 'Whether to detect the text direction of paragraphs and headings automatically (a manually set direction takes precedence)',
                },
                backlinkBlockSort: {
                    // 文档内引用的排序方式
                    type: 'integer',
                    description: 'Sort order of references within a document\n- `0`: Order in the document\n- `1`: Anchor text ascending\n- `2`: Anchor text descending',
                    enum: [
                        0, // 正文顺序
                        1, // 锚文本升序
                        2, // 锚文本降序
                    ],
                },
                backlinkContainChildren: {
                    // 反向链接面板是否包含下级节点
                    type: 'boolean',
                    description: 'Whether the backlink panel contains children',
                },
                backlinkExpandCount: {
                    // 反向链接默认展开数量
                    type: 'integer',
                    description: 'The default number of backlinks to expand',
                },
                backlinkGlobalSort: {
                    // 反向链接的全局排序方式
                    type: 'integer',
                    description: 'Global sort order of backlinks\n- `0`: Group by document (sorted by `backlinkSort` and `backlinkBlockSort`)\n- `1`: Anchor text ascending\n- `2`: Anchor text descending',
                    enum: [
                        0, // 按文档分组
                        1, // 锚文本升序
                        2, // 锚文本降序
                    ],
                },
                backlinkHideReference: {
                    // 反链面板中是否隐藏传递型反链里仅包含块引用的块
                    type: 'boolean',
                    description: 'Whether to hide blocks that only contain block references in propagated backlinks of the backlink panel',
                },
                backlinkMentionExclude: {
                    // 反链提及中排除的关键字，使用英文逗号分隔
                    type: 'string',
                    description: 'Keywords excluded from backlink mentions, separated by commas',
                },
                backlinkShowBottom: {
                    // 是否在文档底部显示反向链接
                    type: 'boolean',
                    description: 'Whether to show backlinks at the bottom of the document',
                },
                backlinkSort: {
                    // 反向链接中文档的排序方式（与文档树的排序方式取值相同）
                    type: 'integer',
                    description: 'Sort order of documents in backlinks (same values as the sort modes of the document tree)\n- `0`/`1`: Name ascending/descending\n- `2`/`3`: Modified time ascending/descending\n- `4`/`5`: Natural name ascending/descending\n- `9`/`10`: Created time ascending/descending',
                    default: 3,
                },
                backmentionExpandCount: {
                    // 反向链接提及默认展开数量
                    type: 'integer',
                    description: 'The default number of backlinks to mention',
                },
                backmentionSort: {
                    // 反链提及中文档的排序方式（取值同 backlinkSort）
                    type: 'integer',
                    description: 'Sort order of documents in backlink mentions (same values as `backlinkSort`)',
                    default: 3,
                },
                blockRefDynamicAnchorTextMaxLen: {
                    // 块引用的动态锚文本最大长度
                    type: 'integer',
                    description: 'The maximum length of the dynamic anchor text for block references',
                },
                checkBlockRef: {
                    // 删除或剪切前是否检查块引用与数据库绑定
                    type: 'boolean',
                    description: 'Whether to check block references and database bindings before deleting or cutting',
                    default: true,
                },
                codeFontFamilies: {
                    // 代码字体，按优先级从高到低排列
                    type: 'array',
                    description: 'Code fonts in descending order of priority',
                    items: {
                        $ref: '#/$defs/font',
                    },
                },
                codeLigatures: {
                    // 代码块是否启用连字符号
                    type: 'boolean',
                    description: 'Whether the code block has enabled ligatures',
                },
                codeLineWrap: {
                    // 代码块是否自动折行
                    type: 'boolean',
                    description: 'Whether the code block is automatically wrapped',
                },
                codeSyntaxHighlightLineNum: {
                    // 代码块是否显示行号
                    type: 'boolean',
                    description: 'Whether the code block displays line numbers',
                },
                codeTabSpaces: {
                    // 代码块中 Tab 键生成的空格数，配置为 0 则表示不转换为空格
                    type: 'integer',
                    description: 'The number of spaces generated by the Tab key in the code block, configured as 0 means no conversion to spaces',
                    minimum: 0,
                },
                cursorSurroundingLines: {
                    // 使用键盘纵向移动光标时，光标上下至少保留的可见行数
                    type: 'integer',
                    description: 'Minimum number of visible lines kept above and below the cursor when moving it vertically with the keyboard',
                    default: 0,
                    minimum: 0,
                    maximum: 20,
                },
                databaseAttrClickMode: {
                    // 点击数据库角标时的行为
                    type: 'integer',
                    description: 'Behavior when clicking a database badge\n- `0`: Focus the block and expand the database panel\n- `1`: Open the block attribute panel',
                    enum: [
                        0, // 聚焦块并展开数据库面板
                        1, // 打开块属性面板
                    ],
                },
                databaseAttrHideEmpty: {
                    // 是否隐藏值为空的数据库属性
                    type: 'boolean',
                    description: 'Whether to hide empty database attributes',
                },
                databaseAttrShow: {
                    // 是否在文档顶部显示数据库属性
                    type: 'boolean',
                    description: 'Whether to show database attributes at the top of the document',
                    default: true,
                },
                databaseAttrUseTabs: {
                    // 是否使用页签展示数据库属性
                    type: 'boolean',
                    description: 'Whether to show database attributes in tabs',
                    default: true,
                },
                databaseAttrViewMode: {
                    // 数据库属性的默认状态
                    type: 'integer',
                    description: 'Default state of database attributes\n- `0`: Expanded\n- `1`: Collapsed',
                    enum: [
                        0, // 展开
                        1, // 折叠
                    ],
                },
                displayBookmarkIcon: {
                    // 是否显示书签图标
                    type: 'boolean',
                    description: 'Whether to display the bookmark icon',
                },
                displayNetImgMark: {
                    // 是否显示网络图片标记
                    type: 'boolean',
                    description: 'Whether to display the network image mark',
                },
                dragHTMLFileToIframe: {
                    // 是否将拖入的 HTML 文件插入为 IFrame 块
                    type: 'boolean',
                    description: 'Whether to insert dragged HTML files as IFrame blocks',
                },
                dynamicLoadBlocks: {
                    // 每次动态加载时加载的块数量
                    type: 'integer',
                    description: 'The number of blocks loaded each time they are dynamically loaded',
                    minimum: 48,
                    maximum: 1024,
                },
                embedBlockBreadcrumb: {
                    // 嵌入块是否显示面包屑
                    type: 'boolean',
                    description: 'Whether the embedded block displays breadcrumbs',
                },
                emoji: {
                    // 常用的表情图标
                    type: 'array',
                    description: 'Common emoji icons',
                    items: {
                        type: 'string',
                        description: 'Emoji icon',
                        examples: [
                            '1f4da', // Emoji 字符的十六进制 Unicode 编码
                            'material/folder-project.svg', // 引用的自定义图标的路径
                        ],
                    },
                },
                floatWindowDelay: {
                    // 悬停触发浮窗的延迟时间（单位: ms），仅在 floatWindowMode 为 0 时生效
                    type: 'integer',
                    description: 'Hover delay before the float window opens (unit: ms), only used when `floatWindowMode` is `0`',
                    default: 620,
                    minimum: 0,
                    maximum: 2000,
                },
                floatWindowMode: {
                    // 预览浮窗的触发模式
                    type: 'integer',
                    description: 'The trigger mode of the preview window\n- `0`: Hover over the cursor\n- `1`: Hover over the cursor while holding down Ctrl\n- `2`: Do not trigger the floating window',
                    enum: [
                        0, // 光标悬停
                        1, // 按住 Ctrl 悬停
                        2, // 不触发浮窗
                    ],
                },
                fontFamilies: {
                    // 编辑器字体，按优先级从高到低排列
                    type: 'array',
                    description: 'Editor fonts in descending order of priority',
                    items: {
                        $ref: '#/$defs/font',
                    },
                },
                fontFamily: {
                    // 编辑器中所使用的字体
                    type: 'string',
                    description: 'The font used in the editor',
                },
                fontFamilyDisplay: {
                    // 首选编辑器字体的显示名称（与 fontFamilies[0].displayName 一致）
                    type: 'string',
                    description: 'Display name of the preferred editor font (same as `fontFamilies[0].displayName`)',
                },
                fontSize: {
                    // 编辑器中所使用的字号
                    type: 'integer',
                    description: 'The font size used in the editor',
                },
                fontSizeScrollZoom: {
                    // 是否开启使用鼠标滚轮调整编辑器字号
                    type: 'boolean',
                    description: 'Whether to enable the use of the mouse wheel to adjust the font size of the editor',
                },
                fontWeight: {
                    // 首选编辑器字体的字重（与 fontFamilies[0].weight 一致，没有字体时为 400）
                    type: 'integer',
                    description: 'Weight of the preferred editor font (same as `fontFamilies[0].weight`, `400` when no font is set)',
                    default: 400,
                },
                fullWidth: {
                    // 编辑器是否使用最大宽度
                    type: 'boolean',
                    description: 'Whether the editor uses maximum width',
                },
                generateHistoryInterval: {
                    // 生成文档历史的时间间隔, 设置为 0 禁用文档历史 (单位: 分钟)
                    type: 'integer',
                    description: 'The time interval for generating document history, set to 0 to disable document history (unit: minutes)',
                    minimum: 0,
                },
                hashTagSearch: {
                    // 输入 # 时是否搜索标签
                    type: 'boolean',
                    description: 'Whether to search tags when typing `#`',
                    default: true,
                },
                headingEmbedMode: {
                    // 标题嵌入块的显示方式
                    type: 'integer',
                    description: 'Display mode of heading embed blocks\n- `0`: The heading and the blocks below it\n- `1`: Only the heading\n- `2`: Only the blocks below the heading',
                    enum: [
                        0, // 标题与其下方的块
                        1, // 仅标题
                        2, // 仅标题下方的块
                    ],
                },
                headingNumber: {
                    // 是否显示自动标题编号
                    type: 'boolean',
                    description: 'Whether to show automatic heading numbers',
                },
                headingNumberFormat: {
                    // 标题编号格式
                    type: 'string',
                    description: 'Heading number format, unknown values are treated as `decimal-hierarchical`',
                    default: 'decimal-hierarchical',
                    examples: [
                        'decimal-hierarchical',
                        'upper-alpha-hierarchical',
                        'lower-alpha-hierarchical',
                        'upper-roman-hierarchical',
                        'lower-roman-hierarchical',
                        'upper-greek-hierarchical',
                        'lower-greek-hierarchical',
                        'decimal-parenthesized',
                        'chinese-document',
                    ],
                },
                historyRetentionDays: {
                    // 历史保留天数
                    type: 'integer',
                    description: 'History retention days',
                },
                justify: {
                    // 是否启用文本两端对齐
                    type: 'boolean',
                    description: 'Whether to enable text justification',
                },
                katexMacros: {
                    // KeTex 宏定义 (JSON 字符串)
                    type: 'string',
                    description: 'KeTex macro definition (JSON string)',
                },
                keepLoadedContent: {
                    // 是否保留已动态加载的内容块
                    type: 'boolean',
                    description: 'Whether to keep dynamically loaded content blocks',
                },
                listItemDotNumberClickFocus: {
                    // 是否启用单击列表项标记聚焦
                    type: 'boolean',
                    description: 'Whether to enable single-click list item mark focus',
                },
                listLogicalOutdent: {
                    // 是否启用列表逻辑反向缩进方案
                    type: 'boolean',
                    description: 'Whether to enable the list logical reverse indentation scheme',
                },
                markdown: {
                    // Markdown 语法输入
                    $ref: '#/$defs/editor_markdown',
                },
                onlySearchForDoc: {
                    // 是否启用 [[ 符号仅搜索文档块
                    type: 'boolean',
                    description: 'Whether to enable the `[[` symbol to search only for document blocks',
                },
                pasteURLAutoConvert: {
                    // 粘贴网址时是否自动转换为链接
                    type: 'boolean',
                    description: 'Whether to convert pasted URLs to links automatically',
                },
                plantUMLServePath: {
                    // PlantUML 渲染服务地址
                    type: 'string',
                    description: 'PlantUML rendering service address',
                },
                readOnly: {
                    // 是否启用只读模式
                    type: 'boolean',
                    description: 'Whether to enable read-only mode',
                },
                rtl: {
                    // 是否启用 RTL (左向书写) 模式
                    type: 'boolean',
                    description: 'Whether to enable RTL (left-to-right chirography) mode',
                },
                spellcheck: {
                    // 是否启用拼写检查
                    type: 'boolean',
                    description: 'Whether to enable spell checking',
                },
                spellcheckLanguages: {
                    // 拼写检查使用的语言
                    type: 'array',
                    description: 'Languages used for spell checking',
                    items: {
                        type: 'string',
                        examples: [
                            'en-US',
                        ],
                    },
                },
                virtualBlockRef: {
                    // 是否启用虚拟引用
                    type: 'boolean',
                    description: 'Whether to enable virtual references',
                },
                virtualBlockRefExclude: {
                    // 虚拟引用关键字排除列表 (关键字之间使用 , 符号分隔)
                    type: 'string',
                    description: 'Virtual reference keyword exclusion list (separated by commas `,`)',
                },
                virtualBlockRefInclude: {
                    // 虚拟引用关键字包含列表 (关键字之间使用 , 符号分隔)
                    type: 'string',
                    description: 'Virtual reference keyword inclusion list (separated by commas `,`)',
                },
            },
        },
        editor_markdown: {
            title: 'IEditorMarkdown',
            type: 'object',

            description: 'Markdown syntax configuration',
            additionalProperties: false,
            required: [
                'blockFullWidthTaskList',
                'codeBlockMiddleDot',
                'inlineAsterisk',
                'inlineFullWidthStrikethrough',
                'inlineMark',
                'inlineMath',
                'inlineStrikethrough',
                'inlineSub',
                'inlineSup',
                'inlineTag',
                'inlineUnderscore',
            ],
            properties: {
                blockFullWidthTaskList: {
                    // 是否启用全角任务列表语法
                    type: 'boolean',
                    description: 'Whether to enable the full-width task list syntax',
                    default: true,
                },
                codeBlockMiddleDot: {
                    // 是否启用使用中点（·）输入代码块的语法
                    type: 'boolean',
                    description: 'Whether to enable the code block syntax using middle dots (`·`)',
                    default: true,
                },
                inlineAsterisk: {
                    // 是否启用星号语法 *foo* **bar**
                    type: 'boolean',
                    description: 'Whether to enable asterisk syntax `*foo*` `**bar**`',
                },
                inlineFullWidthStrikethrough: {
                    // 是否启用全角行级删除线语法
                    type: 'boolean',
                    description: 'Whether to enable the full-width inline strikethrough syntax',
                    default: false,
                },
                inlineMark: {
                    // 是否启用行级标记（高亮）语法
                    type: 'boolean',
                    description: 'Whether to enable the inline mark (highlight) syntax',
                    default: true,
                },
                inlineMath: {
                    // 是否启用行内公式语法 $foo$
                    type: 'boolean',
                    description: 'Whether to enable inline formula syntax `$foo$`',
                },
                inlineStrikethrough: {
                    // 是否启用删除线语法 ~~foo~~
                    type: 'boolean',
                    description: 'Whether to enable strikethrough syntax `~~foo~~`',
                },
                inlineSub: {
                    // 是否启用下标语法 ~foo~
                    type: 'boolean',
                    description: 'Whether to enable subscript syntax `~foo~`',
                },
                inlineSup: {
                    // 是否启用上标语法 ^foo^
                    type: 'boolean',
                    description: 'Whether to enable superscript syntax `^foo^`',
                },
                inlineTag: {
                    // 是否启用标签语法 #foo#
                    type: 'boolean',
                    description: 'Whether to enable tag syntax `#foo#`',
                },
                inlineUnderscore: {
                    // 是否启用下划线语法 _foo_ __bar__
                    type: 'boolean',
                    description: 'Whether to enable underscore syntax `_foo_` `__bar__`',
                },
            },
        },
        editor_assetOpen: {
            title: 'IEditorAssetOpen',
            type: 'object',

            description: 'How assets are opened when clicked',
            additionalProperties: false,
            required: [
                'altClick',
                'click',
                'ctrlClick',
                'shiftClick',
            ],
            properties: {
                altClick: {
                    // Alt + 单击时的打开方式
                    $ref: '#/$defs/editor_assetOpen_mode',
                },
                click: {
                    // 单击时的打开方式
                    $ref: '#/$defs/editor_assetOpen_mode',
                },
                ctrlClick: {
                    // Ctrl/⌘ + 单击时的打开方式
                    $ref: '#/$defs/editor_assetOpen_mode',
                },
                shiftClick: {
                    // Shift + 单击时的打开方式
                    $ref: '#/$defs/editor_assetOpen_mode',
                },
            },
        },
        editor_assetOpen_mode: {
            title: 'TEditorAssetOpenMode',
            type: 'string',

            description: 'How an asset is opened\n- `follow-tab`: Follow the setting of opening tabs without splitting the screen\n- `current`: Current tab area\n- `right`: Right of the tab\n- `bottom`: Below the tab\n- `background`: Background tab\n- `new-window`: New window\n- `app`: Default application\n- `folder`: Show in folder',
            enum: [
                'app', // 使用默认程序打开
                'background', // 在后台页签中打开
                'bottom', // 在页签下方打开
                'current', // 在当前页签区打开
                'folder', // 打开文件所在位置
                'follow-tab', // 跟随打开页签时不分屏的设置
                'new-window', // 在新窗口中打开
                'right', // 在页签右侧打开
            ],
        },
        font: {
            title: 'IFont',
            type: 'object',

            description: 'Font',
            additionalProperties: false,
            required: [
                'displayName',
                'family',
                'weight',
            ],
            properties: {
                displayName: {
                    // 显示名称
                    type: 'string',
                    description: 'Display name',
                },
                family: {
                    // 字体族名称
                    type: 'string',
                    description: 'Font family',
                },
                weight: {
                    // 字重
                    type: 'integer',
                    description: 'Font weight',
                    default: 400,
                    minimum: 1,
                    maximum: 1000,
                },
            },
        },
        export: {
            title: 'IExport',
            type: 'object',

            description: 'SiYuan export related configuration',
            additionalProperties: false,
            required: [
                'includeRelatedDocs',
                'includeSubDocs',
                'inlineMemo',
                'pandocParams',
                'paragraphBeginningSpace',
                'addTitle',
                'blockRefMode',
                'blockEmbedMode',
                'blockRefTextLeft',
                'blockRefTextRight',
                'removeAssetsID',
                'tagOpenMarker',
                'tagCloseMarker',
                'fileAnnotationRefMode',
                'pandocBin',
                'markdownYFM',
                'pdfFooter',
                'docxTemplate',
                'pdfWatermarkStr',
                'pdfWatermarkDesc',
                'imageWatermarkStr',
                'imageWatermarkDesc',
            ],
            properties: {
                includeRelatedDocs: {
                    // 导出时是否同时导出关联文档（块引用、块链接与数据库绑定块所在的文档）
                    type: 'boolean',
                    description: 'Whether to also export related documents (documents of referenced blocks, linked blocks and blocks bound to databases)',
                    default: false,
                },
                includeSubDocs: {
                    // 导出时是否包含子文档
                    type: 'boolean',
                    description: 'Whether to include sub-documents when exporting',
                    default: true,
                },
                inlineMemo: {
                    // 是否导出行级备注
                    type: 'boolean',
                    description: 'Whether to export inline memos',
                    default: false,
                },
                pandocParams: {
                    // Pandoc 的额外命令行参数，换行按空格处理
                    type: 'string',
                    description: 'Extra command line arguments of Pandoc, line breaks are treated as spaces',
                },
                paragraphBeginningSpace: {
                    // 段落开头是否空两格 (段首插入两个全宽空格 `U+3000`)
                    type: 'boolean',
                    description: 'Whether the beginning of the paragraph is empty two spaces.\nInsert two full-width spaces `U+3000` at the beginning of the paragraph.',
                },
                addTitle: {
                    // 添加文章标题 (将文章标题作为第一级标题插入文档首部)
                    type: 'boolean',
                    description: 'Add article title (insert the article title as a first-level title at the beginning of the document)',
                },
                blockRefMode: {
                    // 内容块引用导出模式
                    type: 'integer',
                    description: 'Content block reference export mode\n- `0`: Original text (deprecated)\n- `1`: Quotation block (deprecated)\n- `2`: Anchor text block link\n- `3`: Anchor text only\n- `4`: Footnote\n- `5`: Anchor hash\n',
                    enum: [
                        0, // 原始文本 (已废弃)
                        1, // 引述块 (已废弃)
                        2, // 锚文本块链接
                        3, // 仅锚文本
                        4, // 脚注
                        5, // 锚点哈希
                    ],
                },
                blockEmbedMode: {
                    // 嵌入块导出模式
                    type: 'integer',
                    description: 'Embedded block export mode\n- `0`: Original block content\n- `1`: Quotation block',
                    enum: [
                        0, // 原始块内容
                        1, // 引述块
                    ],
                },
                blockRefTextLeft: {
                    // 导出时块引用锚文本左侧符号
                    type: 'string',
                    description: 'The symbol on the left side of the block reference anchor text during export',
                },
                blockRefTextRight: {
                    // 导出时块引用锚文本右侧符号
                    type: 'string',
                    description: 'The symbol on the right side of the block reference anchor text during export',
                },
                removeAssetsID: {
                    // 导出 Markdown 时是否移除资源文件名中的 ID
                    type: 'boolean',
                    description: 'Whether to remove the IDs in asset file names when exporting Markdown',
                    default: false,
                },
                tagOpenMarker: {
                    // 标签开始标记符号
                    type: 'string',
                    description: 'Tag start marker symbol',
                },
                tagCloseMarker: {
                    // 标签闭合标记符号
                    type: 'string',
                    description: 'Tag close marker symbol',
                },
                fileAnnotationRefMode: {
                    // 文件标注引用导出模式
                    type: 'integer',
                    description: 'File annotation reference export mode\n- `0`: File name - page number - anchor text\n- `1`: Anchor text only',
                    enum: [
                        0, // 文件名 - 页码 - 锚文本
                        1, // 仅锚文本
                    ],
                },
                pandocBin: {
                    // Pandoc 可执行文件路径
                    type: 'string',
                    description: 'Pandoc executable file path',
                },
                markdownYFM: {
                    // Markdown 导出时是否添加 YAML Front Matter
                    type: 'boolean',
                    description: 'Whether to add YAML Front Matter when exporting to Markdown',
                },
                pdfFooter: {
                    // 自定义 PDF 导出时的页脚内容
                    type: 'string',
                    description: 'Custom footer content when exporting to PDF',
                },
                docxTemplate: {
                    // Docx 导出时所使用的模板文件路径
                    type: 'string',
                    description: 'The path of the template file used when exporting to Docx',
                },
                pdfWatermarkStr: {
                    // 导出 PDF 时所使用的水印文本或水印文件路径
                    type: 'string',
                    description: 'The watermark text or watermark file path used when exporting to PDF',
                },
                pdfWatermarkDesc: {
                    // 自定义导出 PDF 时水印的位置、大小和样式等
                    type: 'string',
                    description: 'Custom watermark position, size, style, etc. when exporting to PDF',
                },
                imageWatermarkStr: {
                    // 导出图片时所使用的水印文本或水印文件路径
                    type: 'string',
                    description: 'The watermark text or watermark file path used when exporting to an image',
                },
                imageWatermarkDesc: {
                    // 自定义导出图片时水印的位置、大小和样式等
                    type: 'string',
                    description: 'Custom watermark position, size, style, etc. when exporting to an image',
                },
            },
        },
        fileTree: {
            title: 'IFileTree',
            type: 'object',

            description: 'Document tree related configuration',
            additionalProperties: false,
            required: [
                'allowCreateDeeper',
                'alwaysSelectOpenedFile',
                'boxDocEnabled',
                'closeTabOnDoubleClick',
                'closeTabsOnStart',
                'createDocAtTop',
                'docCreateSaveBox',
                'docCreateSavePath',
                'docCreateTemplatePath',
                'docIconClickExpand',
                'largeFileWarningSize',
                'maxListCount',
                'maxOpenTabCount',
                'noSplitScreenWhenOpenTab',
                'openFilesUseCurrentTab',
                'parentDocClickExpand',
                'recentDocsMaxListCount',
                'refCreateSaveBox',
                'refCreateSavePath',
                'removeDocWithoutConfirm',
                'shorthandSaveBox',
                'shorthandSavePath',
                'sort',
                'tabStartupMode',
                'useSingleLineSave',
                'useSVGDefaultIcon',
            ],
            properties: {
                allowCreateDeeper: {
                    // 是否允许创建超过 7 层深度的子文档
                    type: 'boolean',
                    description: 'Whether to allow the creation of sub-documents deeper than 7 levels',
                },
                alwaysSelectOpenedFile: {
                    // 是否在文档树中自动定位当前打开的文档
                    type: 'boolean',
                    description: 'Whether to automatically locate the currently open document in the document tree',
                },
                boxDocEnabled: {
                    // 是否启用笔记本文档（笔记本本身也可以记录内容）
                    type: 'boolean',
                    description: 'Whether to enable notebook documents (a notebook itself can hold content)',
                    default: false,
                },
                closeTabOnDoubleClick: {
                    // 是否双击页签关闭页签
                    type: 'boolean',
                    description: 'Whether to close a tab by double-clicking it',
                },
                closeTabsOnStart: {
                    // 是否在启动时关闭所有页签
                    type: 'boolean',
                    description: 'Whether to close all tabs when starting',
                },
                createDocAtTop: {
                    // 是否在文档树顶部创建新文档
                    type: 'boolean',
                    description: 'Whether to create new documents at the top of the document tree',
                },
                docCreateSaveBox: {
                    // 新建文档的存储笔记本
                    type: 'string',
                    description: 'The notebook to storage the new document',
                },
                docCreateSavePath: {
                    // 新建文档的存储路径
                    type: 'string',
                    description: 'The storage path of the new document',
                },
                docCreateTemplatePath: {
                    // 新建文档使用的模板路径（相对于 data/templates/），为空时不使用模板，笔记本的设置优先
                    type: 'string',
                    description: 'Template path for new documents (relative to `data/templates/`), no template when empty, the notebook setting takes precedence',
                },
                docIconClickExpand: {
                    // 单击文档或笔记本图标时是否展开或折叠下级文档
                    type: 'boolean',
                    description: 'Whether clicking a document or notebook icon expands or collapses its child documents',
                },
                largeFileWarningSize: {
                    // 文档或数据库文件的大小超过该值时提醒（单位: MB）
                    type: 'integer',
                    description: 'Warn when a document or database file is larger than this size (unit: MB)',
                    default: 8,
                    minimum: 2,
                },
                maxListCount: {
                    // 文档的最大列出数量
                    type: 'integer',
                    description: 'The maximum number of documents listed',
                },
                maxOpenTabCount: {
                    // 最大打开页签数量
                    type: 'integer',
                    description: 'The maximum number of open tabs',
                },
                noSplitScreenWhenOpenTab: {
                    // 打开搜索、PDF 等页签时是否不自动分屏
                    type: 'boolean',
                    description: 'Whether to avoid splitting the screen automatically when opening search, PDF and similar tabs',
                },
                openFilesUseCurrentTab: {
                    // 是否在当前页签打开文件
                    type: 'boolean',
                    description: 'Whether to open the file in the current tab',
                },
                parentDocClickExpand: {
                    // 单击父文档标题时是否展开或折叠下级文档
                    type: 'boolean',
                    description: 'Whether clicking the title of a parent document expands or collapses its child documents',
                },
                recentDocsMaxListCount: {
                    // 最近文档的最大列出数量
                    type: 'integer',
                    description: 'Maximum number of recent documents listed',
                    minimum: 32,
                    maximum: 256,
                },
                refCreateSaveBox: {
                    // 使用块引用新建文档的存储笔记本
                    type: 'string',
                    description: 'The notebook to storage the new document created using block references',
                },
                refCreateSavePath: {
                    // 使用块引用新建文档的存储路径
                    type: 'string',
                    description: 'The storage path of the new document created using block references',
                },
                removeDocWithoutConfirm: {
                    // 关闭删除文档时的二次确认
                    type: 'boolean',
                    description: 'Close the secondary confirmation when deleting a document',
                },
                shorthandSaveBox: {
                    // 闪念速记保存到的笔记本 ID
                    type: 'string',
                    description: 'ID of the notebook where shorthands are saved',
                },
                shorthandSavePath: {
                    // 闪念速记的保存路径（可读路径，支持模板语法）
                    type: 'string',
                    description: 'Save path of shorthands (human-readable path, supporting template syntax)',
                },
                sort: {
                    // 文档排序方式
                    type: 'integer',
                    description: 'Document sorting method\n- `0`: File name ascending\n- `1`: File name descending\n- `2`: File update time ascending\n- `3`: File update time descending\n- `4`: File name natural number ascending\n- `5`: File name natural number descending\n- `6`: Custom sorting\n- `7`: Reference count ascending\n- `8`: Reference count descending\n- `9`: File creation time ascending\n- `10`: File creation time descending\n- `11`: File size ascending\n- `12`: File size descending\n- `13`: Sub-document count ascending\n- `14`: Sub-document count descending\n- `15`: Use document tree sorting rules\n- `256`: Unspecified sorting rules, according to the notebook priority over the document tree to obtain sorting rules',
                    enum: [
                        0, // 文件名字母升序
                        1, // 文件名字母降序
                        2, // 文件更新时间升序
                        3, // 文件更新时间降序
                        4, // 文件名自然数升序
                        5, // 文件名自然数降序
                        6, // 自定义排序
                        7, // 引用数升序
                        8, // 引用数降序
                        9, // 文件创建时间升序
                        10, // 文件创建时间降序
                        11, // 文件大小升序
                        12, // 文件大小降序
                        13, // 子文档数升序
                        14, // 子文档数降序
                        15, // 使用文档树排序规则
                        256, // 未指定排序规则，按照笔记本优先于文档树获取排序规则
                    ],
                },
                tabStartupMode: {
                    // 启动时如何处理页签
                    type: 'integer',
                    description: 'How tabs are handled on startup\n- `0`: Restore all tabs\n- `1`: Restore all tabs and show the start page\n- `2`: Close all tabs',
                    enum: [
                        0, // 恢复所有页签
                        1, // 恢复所有页签并显示起始页
                        2, // 关闭所有页签
                    ],
                },
                useSingleLineSave: {
                    // 是否将 .sy 文件的内容保存为单行的 JSON 对象
                    type: 'boolean',
                    description: 'Whether to save the content of the .sy file as a single-line JSON object',
                },
                useSVGDefaultIcon: {
                    // 未设置图标的笔记本与文档是否使用 SVG 默认图标
                    type: 'boolean',
                    description: 'Whether notebooks and documents without an icon use the default SVG icons',
                },
            },
        },
        flashcard: {
            title: 'IFlashCard',
            type: 'object',

            description: 'Flashcard related configuration',
            additionalProperties: false,
            required: [
                'blockquote',
                'callout',
                'deck',
                'heading',
                'list',
                'mark',
                'maximumInterval',
                'newCardLimit',
                'requestRetention',
                'reviewCardLimit',
                'reviewMode',
                'superBlock',
                'weights',
            ],
            properties: {
                blockquote: {
                    // 是否启用引述块制卡
                    type: 'boolean',
                    description: 'Whether to make flashcards from blockquotes',
                    default: true,
                },
                callout: {
                    // 是否启用提示块制卡
                    type: 'boolean',
                    description: 'Whether to make flashcards from callouts',
                    default: true,
                },
                deck: {
                    // 是否启用卡包制卡
                    type: 'boolean',
                    description: 'Whether to enable deck card making',
                },
                heading: {
                    // 是否启用标题块制卡
                    type: 'boolean',
                    description: 'Whether to enable heading block card making',
                },
                list: {
                    // 是否启用列表块制卡
                    type: 'boolean',
                    description: 'Whether to enable list block card making',
                },
                mark: {
                    // 是否启用标记元素制卡
                    type: 'boolean',
                    description: 'Whether to enable mark element card making',
                },
                maximumInterval: {
                    // 最大间隔天数
                    type: 'integer',
                    description: 'Maximum interval days',
                },
                newCardLimit: {
                    // 新卡上限
                    type: 'integer',
                    description: 'New card limit',
                },
                requestRetention: {
                    // FSRS 请求保留参数
                    type: 'number',
                    description: 'FSRS request retention parameter',
                },
                reviewCardLimit: {
                    // 复习卡上限
                    type: 'integer',
                    description: 'Review card limit',
                },
                reviewMode: {
                    // 复习模式
                    type: 'integer',
                    description: 'Review mode\n- `0`: New and old mixed\n- `1`: New card priority\n- `2`: Old card priority',
                    enum: [
                        0, // 新旧混合
                        1, // 新卡优先
                        2, // 旧卡优先
                    ],
                },
                superBlock: {
                    // 是否启用超级块制卡
                    type: 'boolean',
                    description: 'Whether to enable super block card making',
                },
                weights: {
                    // FSRS 权重参数列表
                    type: 'string',
                    description: 'FSRS weight parameter list',
                },
            },
        },
