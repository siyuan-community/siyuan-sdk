{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/filetree/getDoc/response.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "response body",
            "description": "Get block HTML DOM and other information",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "msg",
                "data"
            ],
            "properties": {
                "code": {
                    "type": "integer",
                    "description": "status code"
                },
                "msg": {
                    "type": "string",
                    "description": "status message"
                },
                "data": {
                    "$ref": "#/$defs/data"
                }
            }
        },
        "data": {
            "title": "IData",
            "description": "Response information",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "blockCount",
                "box",
                "content",
                "eof",
                "headingNumbers",
                "id",
                "isBacklinkExpand",
                "isSyncing",
                "keywords",
                "mode",
                "parent2ID",
                "parentID",
                "path",
                "publishAccessRequired",
                "reqId",
                "rootID",
                "scroll",
                "type"
            ],
            "properties": {
                "blockCount": {
                    "type": "integer",
                    "description": "Block count"
                },
                "box": {
                    "type": "string",
                    "description": "Notebook ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "content": {
                    "type": "string",
                    "description": "HTML DOM string"
                },
                "eof": {
                    "type": "boolean",
                    "description": "End Of File"
                },
                "id": {
                    "type": "string",
                    "description": "Block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "isBacklinkExpand": {
                    "type": "boolean",
                    "description": "is backlink detail?"
                },
                "isSyncing": {
                    "type": "boolean",
                    "description": "is syncing?"
                },
                "keywords": {
                    "description": "Document keywords",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "mode": {
                    "type": "integer",
                    "description": "Load mode"
                },
                "parent2ID": {
                    "type": "string",
                    "description": "Logic parent block ID\nif heading exists, it is heading block ID\nelse equal parentID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "parentID": {
                    "type": "string",
                    "description": "Parent block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "path": {
                    "type": "string",
                    "description": "Document path, which needs to start with / and separate levels with /\npath here corresponds to the database path field",
                    "pattern": "^(/\\d{14}-[0-9a-z]{7})+\\.sy$",
                    "examples": [
                        "/20200812220555-lj3enxa.sy",
                        "/20200812220555-lj3enxa/20210808180320-fqgskfj.sy"
                    ]
                },
                "reqId": {
                    "description": "Request ID (Unix timestamp)",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "integer"
                        }
                    ]
                },
                "rootID": {
                    "type": "string",
                    "description": "Document block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "scroll": {
                    "type": "boolean",
                    "description": "is dynamic loading?"
                },
                "type": {
                    "title": "TBlockType",
                    "type": "string",
                    "description": "Block type",
                    "enum": [
                        "NodeDocument",
                        "NodeSuperBlock",
                        "NodeBlockquote",
                        "NodeList",
                        "NodeListItem",
                        "NodeHeading",
                        "NodeParagraph",
                        "NodeMathBlock",
                        "NodeTable",
                        "NodeCodeBlock",
                        "NodeHTMLBlock",
                        "NodeThematicBreak",
                        "NodeAudio",
                        "NodeVideo",
                        "NodeIFrame",
                        "NodeWidget",
                        "NodeBlockQueryEmbed",
                        "NodeAttributeView"
                    ]
                },
                "docInfo": {
                    "$ref": "#/$defs/docInfo"
                },
                "headingNumbers": {
                    "description": "Map from heading block IDs to heading numbers, an empty object when heading numbers are disabled or there are no headings, `null` in some loading modes",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string",
                                "examples": [
                                    "1.2"
                                ]
                            }
                        }
                    ]
                },
                "publishAccessRequired": {
                    "type": "boolean",
                    "description": "Whether the document requires a password in the publish service (`content` is replaced when required)"
                }
            }
        },
        "docInfo": {
            "title": "IDocInfo",
            "description": "Document information",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "attrViews",
                "ial",
                "icon",
                "id",
                "name",
                "refCount",
                "refIDs",
                "rootID",
                "subFileCount"
            ],
            "properties": {
                "attrViews": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Attribute view reference list, `null` when the document is not bound to any database",
                    "items": {
                        "$ref": "#/$defs/docInfo_attrView"
                    }
                },
                "ial": {
                    "type": "object",
                    "description": "Inline Attribute List (IAL) of the document block",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "icon": {
                    "type": "string",
                    "description": "Document icon"
                },
                "id": {
                    "type": "string",
                    "description": "Block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "name": {
                    "type": "string",
                    "description": "Document name"
                },
                "refCount": {
                    "type": "integer",
                    "description": "The number of references to the document"
                },
                "refIDs": {
                    "type": "array",
                    "description": "IDs of the blocks referencing the document",
                    "items": {
                        "type": "string",
                        "pattern": "^\\d{14}-[0-9a-z]{7}$"
                    }
                },
                "rootID": {
                    "type": "string",
                    "description": "Document block ID",
                    "pattern": "^\\d{14}-[0-9a-z]{7}$"
                },
                "subFileCount": {
                    "type": "integer",
                    "description": "The number of sub-documents"
                }
            }
        },
        "docInfo_attrView": {
            "title": "IDocInfoAttrView",
            "description": "Attribute view",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Attribute view ID"
                },
                "name": {
                    "type": "string",
                    "description": "Attribute view name"
                }
            }
        }
    }
}