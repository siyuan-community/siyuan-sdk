/**
 * schemas/kernel/api/storage/getRecentDocs/response.schema.json5
 * 获取最近更新的文档
 * REF: https://github.com/siyuan-note/siyuan/blob/v3.8.6/kernel/api/storage.go#L217-L232
 * @pathname: /api/storage/getRecentDocs
 * @version: 3.8.6
 */
{
    $schema: 'https://json-schema.org/draft/2020-12/schema',
    $id: 'https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/storage/getRecentDocs/response.schema.json5',
    $comment: 'v3.8.6',
    $ref: '#/$defs/root',
    $defs: {
        root: {
            title: 'response body',
            description: 'Get the most recently updated documentation',

            type: 'object',
            additionalProperties: false,
            required: [
                'code',
                'msg',
                'data',
            ],
            properties: {
                code: {
                    type: 'integer',
                    description: 'status code',
                },
                msg: {
                    type: 'string',
                    description: 'status message',
                },
                data: {
                    type: [
                        'array',
                        'null',
                    ],
                    description: 'document info list',

                    items: {
                        $ref: '#/$defs/datum',
                    },
                },
            },
        },
        datum: {
            title: 'IDocInfo',
            type: 'object',
            additionalProperties: false,
            required: [
                'rootID',
                'title',
            ],
            properties: {
                rootID: {
                    // 文档块 ID
                    type: 'string',
                    description: 'Document Block ID',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                },
                icon: {
                    // 文档图标
                    type: 'string',
                    description: 'Document icon',
                    examples: [
                        '1f3d8',
                        'icon.svg',
                        'folder/icon.png',
                    ],
                },
                title: {
                    // 文档标题
                    type: 'string',
                    description: 'Document title',
                    pattern: '^[^/]+$',
                },
                closedAt: {
                    // 页签关闭时间（Unix 时间戳，单位: s），为 0 时不返回
                    type: 'integer',
                    description: 'Time when the tab was closed (Unix timestamp, unit: s), omitted when `0`',
                },
                openAt: {
                    // 从文档树打开到页签的时间（Unix 时间戳，单位: s），为 0 时不返回
                    type: 'integer',
                    description: 'Time when the document was opened in a tab from the document tree (Unix timestamp, unit: s), omitted when `0`',
                },
                viewedAt: {
                    // 最近浏览时间（Unix 时间戳，单位: s），为 0 时不返回
                    type: 'integer',
                    description: 'Last viewed time (Unix timestamp, unit: s), omitted when `0`',
                },
            },
        },
    },
}
