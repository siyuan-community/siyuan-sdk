{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/query/sql/response.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "response body",
            "description": "render template file",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "limit",
                "msg",
                "data",
                "truncated"
            ],
            "properties": {
                "code": {
                    "type": "integer",
                    "description": "status code"
                },
                "msg": {
                    "type": "string",
                    "description": "status message"
                },
                "data": {
                    "$ref": "#/$defs/data"
                },
                "limit": {
                    "type": "integer",
                    "description": "Default row limit appended by the kernel (the search limit setting), `0` when the statement has its own `LIMIT`",
                    "minimum": 0
                },
                "truncated": {
                    "type": "boolean",
                    "description": "Whether the result was truncated by the default row limit"
                }
            }
        },
        "data": {
            "title": "IData",
            "description": "response data",
            "type": "array",
            "items": {
                "$ref": "#/$defs/datum"
            }
        },
        "datum": {
            "title": "IDatum",
            "description": "query results",
            "type": "object",
            "additionalProperties": true,
            "required": [],
            "properties": {}
        }
    }
}