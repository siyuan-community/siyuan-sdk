        uiLayout_tab_graph: {
            title: 'IUILayoutTabGraph',
            type: 'object',

            description: 'SiYuan graph tab',
            additionalProperties: false,
            required: [
                'blockId',
                'instance',
                'rootId',
                'type',
            ],
            properties: {
