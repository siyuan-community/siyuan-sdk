/**
 * schemas/kernel/api/filetree/searchDocs/payload.schema.json5
 * 通过关键词搜索文档
 * REF: https://github.com/siyuan-note/siyuan/blob/v3.8.6/kernel/api/filetree.go#L1115-L1126
 * @pathname: /api/filetree/searchDocs
 * @version: 3.8.6
 */
{
    $schema: 'https://json-schema.org/draft/2020-12/schema',
    $id: 'https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/filetree/searchDocs/payload.schema.json5',
    $comment: 'v3.8.6',
    $ref: '#/$defs/root',
    $defs: {
        root: {
            title: 'payload body',
            description: 'Search Document by Keyword',

            type: 'object',
            additionalProperties: false,
            required: [
                'k',
            ],
            properties: {
                k: {
                    // 关键字
                    type: 'string',
                    minLength: 1,
                    description: 'keyword',
                },
                flashcard: {
                    // 是否是复习卡片
                    type: 'boolean',
                    description: 'whether is flashcard',
                    default: false,
                },
                excludeIDs: {
                    // 排除的文档 ID 列表（同时排除其子文档）
                    type: 'array',
                    description: 'IDs of documents to exclude (their sub-documents are also excluded)',
                    items: {
                        type: 'string',
                        pattern: '^\\d{14}-[0-9a-z]{7}$',
                    },
                },
            },
        },
    },
}
