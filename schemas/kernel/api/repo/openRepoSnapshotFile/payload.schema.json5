/**
 * schemas/kernel/api/repo/openRepoSnapshotFile/payload.schema.json5
 * 读取快照中的文件
 * REF: https://github.com/siyuan-note/siyuan/blob/v3.8.6/kernel/api/repo.go#L91-L104
 * @pathname: /api/repo/openRepoSnapshotFile
 * @version: 3.8.6
 */
{
    $schema: 'https://json-schema.org/draft/2020-12/schema',
    $id: 'https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/repo/openRepoSnapshotFile/payload.schema.json5',
    $comment: 'v3.8.6',
    $ref: '#/$defs/root',
    $defs: {
        root: {
            title: 'payload body',
            description: 'Read a file in the repository snapshot',

            type: 'object',
            additionalProperties: false,
            required: [
                'id',
            ],
            properties: {
                id: {
                    // 快照文件对象 ID
                    type: 'string',
                    description: 'Snapshot file object ID',
                    pattern: '^[0-9a-f]{40}$',
                },
            },
        },
    },
}
