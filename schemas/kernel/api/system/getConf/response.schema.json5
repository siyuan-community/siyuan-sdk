                rootId: {
                    // 文档块 ID
                    type: 'string',
                    description: '(Graph) Document block ID',
                    pattern: '^\\d{14}-[0-9a-z]{7}$',
                },
                type: {
                    // 反向链接页签类型
                    type: 'string',
                    title: 'TUILayoutTabGraphType',
                    description: '(Graph) Tab type\n- `pin`: Pinned graph\n- `local`: Graph of the current editor\n- `global`: Global graph',
                    enum: [
