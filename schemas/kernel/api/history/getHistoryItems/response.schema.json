{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/siyuan-community/siyuan-sdk/raw/main/schemas/kernel/api/history/getHistoryItems/response.schema.json",
    "$comment": "v3.8.6",
    "$ref": "#/$defs/root",
    "$defs": {
        "root": {
            "title": "response body",
            "description": "Query the list of historical items",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "msg",
                "data"
            ],
            "properties": {
                "code": {
                    "type": "integer",
                    "description": "status code"
                },
                "msg": {
                    "type": "string",
                    "description": "status message"
                },
                "data": {
                    "$ref": "#/$defs/data"
                }
            }
        },
        "data": {
            "title": "IData",
            "description": "Response information",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "items"
            ],
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/item"
                    }
                }
            }
        },
        "item": {
            "title": "IItem",
            "description": "History item",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "notebook",
                "op",
                "title",
                "path"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Historical document title"
                },
                "path": {
                    "type": "string",
                    "description": "Absolute path of the historical document file"
                },
                "id": {
                    "type": "string",
                    "description": "ID of the object in the history (the document ID for documents, the attribute view ID for databases, may be empty for assets)"
                },
                "notebook": {
                    "type": "string",
                    "description": "ID of the notebook containing the document (only meaningful for document histories)"
                },
                "op": {
                    "type": "string",
                    "title": "THistoryOperation",
                    "description": "Operation that produced the history\n- `clean`: Clean up unused assets or databases\n- `update`: Update\n- `delete`: Delete\n- `format`: Format\n- `sync`: Overwritten by sync\n- `replace`: Replace\n- `outline`: Edit in the outline panel",
                    "enum": [
                        "clean",
                        "delete",
                        "format",
                        "outline",
                        "replace",
                        "sync",
                        "update"
                    ]
                }
            }
        }
    }
}