# cspell:words VITE

# 测试环境变量 | Environment variables for tests
# 复制为 .env 并按实际环境填写 | Copy to .env and fill in

# 思源内核服务地址 | SiYuan kernel URL
VITE_SIYUAN_SERVE=http://127.0.0.1:6806

# 思源 API token（设置 - 关于 - API token） | SiYuan API token (Settings - About - API token)
VITE_SIYUAN_TOKEN=

# 专用于测试的工作空间目录，必须与内核当前打开的工作空间一致
# 测试会创建并删除笔记本、文件等数据，请勿指向日常使用的工作空间
# Dedicated test workspace directory, must match the workspace opened by the kernel
# Tests create and remove notebooks, files and other data, never point it to a workspace in daily use
VITE_SIYUAN_WORKSPACE=
